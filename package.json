{
  "name": "astro-aya",
  "version": "1.2.0",
  "private": true,
  "description": "SilentCage —— 个人博客：技术笔记、随笔与游记，Navidrome 音乐收藏与 Bangumi 追番，文章按分类与标签组织",
  "author": "Resalia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shtraiy/astro-aya-project.git"
  },
  "keywords": [
    "blog",
    "astro",
    "tailwindcss",
    "typescript",
    "silentcage",
    "categories",
    "navidrome",
    "bangumi",
    "vercel"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && npm run search:index",
    "build:vercel": "npm run sync:bangumi && npm run sync:friend-circle && npm run build",
    "preview": "astro preview",
    "search:index": "pagefind --site dist",
    "search:index:dev": "pagefind --site dist --output-subdir ../public/pagefind",
    "sync": "astro sync",
    "sync:navidrome": "node --env-file-if-exists=.env scripts/sync-navidrome.mjs",
    "sync:bangumi": "node --env-file-if-exists=.env scripts/sync-bangumi.mjs",
    "sync:friend-circle": "node --env-file-if-exists=.env scripts/sync-friend-circle.mjs",
    "astro": "astro",
    "format:check": "prettier --check . --plugin=prettier-plugin-astro",
    "format": "prettier --write . --plugin=prettier-plugin-astro",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=9"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.7",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/transformers": "^4.4.3",
    "astro": "^7.3.2",
    "lodash.kebabcase": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-collapse": "^0.1.2",
    "remark-github-blockquote-alert": "^1.3.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@pagefind/default-ui": "^1.5.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/react": "^18.3.6",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/parser": "^8.5.0",
    "astro-eslint-parser": "^1.0.3",
    "eslint": "^9.10.0",
    "eslint-plugin-astro": "^1.2.4",
    "fontverter": "^2.0.0",
    "globals": "^15.9.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.5.0"
  }
}
