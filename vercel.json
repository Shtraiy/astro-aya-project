{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/archives", "destination": "/posts/", "permanent": true },
    { "source": "/archives/", "destination": "/posts/", "permanent": true },
    {
      "source": "/posts/:page(\\d+)",
      "destination": "/posts/",
      "permanent": true
    }
  ]
}
