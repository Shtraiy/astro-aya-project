# Auto detect text files and perform LF normalization
* text=auto

# Keep source and documentation line endings stable across Windows/Linux
*.astro text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# 无扩展名的配置文件也一并固定为 LF，避免本地（core.autocrlf=true）
# 与 CI（Linux 检出）看到不同的行尾，导致 format:check 结果不一致
.prettierrc text eol=lf
