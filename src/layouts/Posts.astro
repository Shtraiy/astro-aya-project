---
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import TagCloud from "@components/TagCloud.astro";
import { SITE } from "@config";
import { getReadingTime } from "@utils/getReadingTime";
import getPostsByGroupCondition from "@utils/getPostsByGroupCondition";
import type { CollectionEntry } from "astro:content";

/**
 * 文章页版式：按年份分组的卡片流。
 *
 * 以前是「卡片 / 时间轴」两个视图来回切，但两者内容高度重叠，读者每次还得先选一次；
 * 现在合成一个：年份当分组标题（延续原来那枚巨大的年份水印），组内直接排卡片，
 * 页头的年份条负责"按年速查"这件时间轴唯一独有的好事。
 *
 * 不再分页：全部文章一页到底，旧的 /posts/2 … /posts/6 在 vercel.json 里 301 回这里。
 */
export interface Props {
  /** 已经按时间倒序排好的文章 */
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const years = Object.entries(
  getPostsByGroupCondition(posts, post => post.data.pubDatetime.getFullYear())
)
  .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
  .map(([year, yearPosts]) => ({
    year,
    count: yearPosts.length,
    posts: yearPosts,
  }));
---

<Layout title={`文章 | ${SITE.title}`}>
  <Header activeNav="posts" />
  <Main
    pageTitle="文章"
    pageDesc={`全部 ${posts.length} 篇，按年份分组 · 想按栏目看走分类页`}
    icon="book"
  >
    <nav class="year-strip" aria-label="按年份跳转">
      {
        years.map(({ year, count }) => (
          <a class="year-chip" href={`#year-${year}`}>
            <span class="year-chip-year">{year}</span>
            <span class="year-chip-count">{count}</span>
          </a>
        ))
      }
    </nav>

    {
      years.map(({ year, count, posts: yearPosts }) => (
        <div class="year-group" id={`year-${year}`}>
          <h2 class="year-head">
            {/* 装饰用的巨大年份水印，压在标题下面 */}
            <span class="year-ghost" aria-hidden="true">
              {year}
            </span>
            <span class="year-label">{year}</span>
            <span class="year-count">{count} 篇</span>
          </h2>
          <ul>
            {yearPosts.map(post => (
              <Card
                href={`/posts/${post.id}/`}
                frontmatter={post.data}
                readingTime={getReadingTime(post.body ?? "")}
              />
            ))}
          </ul>
        </div>
      ))
    }
  </Main>

  <aside class="side-rail">
    <TagCloud limit={20} />
  </aside>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  /* ===== 年份快捷条（替代原时间轴视图的速查作用）===== */
  .year-strip {
    @apply mb-8 flex flex-wrap gap-2;
  }
  .year-chip {
    @apply inline-flex items-center gap-1.5 rounded-xl border px-3 py-1 text-sm no-underline transition-colors;
    border-color: rgb(var(--palette-border));
    color: rgb(var(--palette-text));
  }
  .year-chip:hover {
    color: rgb(var(--palette-accent));
    border-color: color-mix(
      in srgb,
      rgb(var(--palette-accent)) 45%,
      transparent
    );
  }
  .year-chip-year {
    @apply font-mono;
  }
  .year-chip-count {
    @apply text-xs;
    color: rgb(var(--palette-muted-text));
  }

  /* ===== 年份分组 ===== */
  .year-group {
    @apply mb-10;
    /* 从年份条跳过来时，给标题留一点上边距 */
    scroll-margin-top: 1.5rem;
  }
  /*
    年份水印：给标题单独留出一条高带，让放大的年份整个待在带内，
    这样它只和年份标题叠在一起，不会糊到下面的卡片上。
  */
  .year-head {
    position: relative;
    padding-top: 2.75rem;
    @apply mb-2 flex items-baseline gap-3;
  }
  .year-ghost {
    position: absolute;
    top: 0;
    left: -0.05em;
    font-size: 4.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: rgb(var(--palette-text));
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
  }
  .year-label {
    @apply relative z-10 text-2xl font-bold;
  }
  .year-count {
    @apply relative z-10 text-sm;
    color: rgb(var(--palette-muted-text));
  }
</style>
