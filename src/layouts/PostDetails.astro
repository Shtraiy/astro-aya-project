---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Icon from "@components/Icon.astro";
import TOC from "@components/TOC.astro";
import Datetime from "@components/Datetime";
import Comments from "@components/Comments.astro";
import PostCopyright from "@components/PostCopyright.astro";
import { render, type CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import { SITE } from "@config";
import { getReadingTime } from "@utils/getReadingTime";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  category,
  editPost,
} = post.data;

const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body ?? "");

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url: canonicalURL ?? Astro.url.href,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL ?? Astro.url.href,
  },
  image: ogUrl,
  datePublished: pubDatetime.toISOString(),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: author,
      url: SITE.profile,
    },
  ],
  publisher: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.profile,
  },
};

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  category,
  tags,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ==========
   优先在同一「主标签」（frontmatter 里的第一个标签）内循环，读同一主题时更连贯；
   标签下文章不足 3 篇就退回全站列表。到头绕回，不再出现"第一篇没有上一篇"。 */

const allPosts = posts.map(({ data: { title, tags: postTags }, id }) => ({
  id,
  title,
  tags: postTags,
}));

const primaryTag = tags[0];
const tagSiblings = primaryTag
  ? allPosts.filter(entry => entry.tags.includes(primaryTag))
  : [];

const navigationList = tagSiblings.length >= 3 ? tagSiblings : allPosts;
const navigationTotal = navigationList.length;
const currentPostIndex = navigationList.findIndex(
  entry => entry.id === post.id
);

const prevPost =
  navigationTotal > 1 && currentPostIndex >= 0
    ? navigationList[(currentPostIndex - 1 + navigationTotal) % navigationTotal]
    : null;
const nextCandidate =
  navigationTotal > 1 && currentPostIndex >= 0
    ? navigationList[(currentPostIndex + 1) % navigationTotal]
    : null;
// 列表只有两篇时 prev / next 会指向同一篇，别左右各显示一次
const nextPost =
  nextCandidate && nextCandidate.id !== prevPost?.id ? nextCandidate : null;
---

<Layout {...layoutProps}>
  <Header />

  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <button
      class="focus-outline mt-8 mb-2 flex items-center hover:opacity-75"
      onclick="(() => (history.length === 1) ? window.location = '/' : history.back())()"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        ><path
          d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
        ></path>
      </svg><span>返回上页</span>
    </button>
  </div>
  <main id="main-content">
    <h1 transition:name={slugifyStr(title)} class="post-title">{title}</h1>

    {/* 文章元信息：日期 / 阅读时长 / 标签，统一走图标行 */}
    <div class="post-meta">
      <Datetime
        pubDatetime={pubDatetime}
        modDatetime={modDatetime}
        size="sm"
        className=""
        editPost={editPost}
        postId={post.id}
      />
      <span class="post-meta-item">
        <Icon name="clock" />
        <span>阅读约 {readingTime}</span>
      </span>
      <span class="post-meta-item">
        <Icon name="folder" />
        <a href={`/categories/${category}/`}>{category}</a>
      </span>
      {
        tags.length > 0 && (
          <span class="post-meta-item">
            <Icon name="hashtag" />
            <span>
              {tags.map((tag, index) => (
                <>
                  <a href={`/tags/${slugifyStr(tag)}/`}>{tag}</a>
                  {index < tags.length - 1 && (
                    <span class="post-meta-sep">/</span>
                  )}
                </>
              ))}
            </span>
          </span>
        )
      }
    </div>

    <article id="article" class="prose mt-8 max-w-3xl text-lg">
      <Content />
    </article>

    <PostCopyright
      title={title}
      author={author}
      pubDatetime={pubDatetime}
      url={canonicalURL ?? Astro.url.href}
    />

    <div class="my-8 flex items-center justify-end">
      <button
        id="back-to-top"
        class="focus-outline flex shrink-0 items-center gap-1 whitespace-nowrap hover:opacity-75"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          class="h-5 w-5 rotate-90"
          ><path
            d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
          ></path></svg
        >
        <span>回到顶部</span>
      </button>
    </div>

    <hr class="my-6 border-dashed" />

    <!-- Previous/Next Post Buttons -->
    <div class="flex flex-col gap-6 sm:flex-row sm:justify-between">
      {
        prevPost && (
          <a
            href={`/posts/${prevPost.id}`}
            class="flex items-center gap-1 hover:opacity-75"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left flex-none"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M15 6l-6 6l6 6" />
            </svg>
            <div>
              <span>上一篇文章</span>
              <div class="text-skin-accent/85 text-sm">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={`/posts/${nextPost.id}`}
            class="flex items-center justify-end gap-1 text-right hover:opacity-75 sm:ml-auto"
          >
            <div>
              <span>下一篇文章</span>
              <div class="text-skin-accent/85 text-sm">{nextPost.title}</div>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right flex-none"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </svg>
          </a>
        )
      }
    </div>
    <Comments />
    <aside class="side-rail">
      <TOC headings={headings} />
    </aside>
  </main>

  <!-- JSON-LD Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
    is:inline
  />

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";
  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
  }
  .post-title {
    @apply text-skin-accent text-2xl font-semibold;
  }
</style>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-skin-fill";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-skin-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className = "heading-link";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /**
   * 给 shiki 生成的代码块补上「语言标签 + 复制按钮」的头部。
   * 语言直接读 Astro/shiki 写在 pre 上的 data-language，所以不需要
   * shiki transformer，也不用新增依赖。样式见 base.css 的 .code-block 段。
   */
  function enhanceCodeBlocks() {
    const copyIcon =
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z"></path><path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"></path></svg>';
    const checkIcon =
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5l10 -10"></path></svg>';

    const codeBlocks = Array.from(document.querySelectorAll("pre.astro-code"));

    for (const codeBlock of codeBlocks) {
      // 视图切换后脚本会重跑，处理过的代码块直接跳过
      if (codeBlock.parentElement?.classList.contains("code-block")) continue;

      const language = (codeBlock.dataset.language ?? "").trim();

      const container = document.createElement("div");
      container.className = "code-block";

      const header = document.createElement("div");
      header.className = "code-block-header";

      const label = document.createElement("span");
      label.className = "code-block-lang";
      label.textContent = language === "plaintext" ? "text" : language;

      const copyButton = document.createElement("button");
      copyButton.type = "button";
      copyButton.className = "code-block-copy";
      copyButton.setAttribute("aria-label", "复制代码");
      copyButton.innerHTML = copyIcon + "<span>复制</span>";

      header.append(label, copyButton);
      codeBlock.parentNode?.insertBefore(container, codeBlock);
      container.append(header, codeBlock);

      copyButton.addEventListener("click", async () => {
        const code = codeBlock.querySelector("code");
        try {
          await navigator.clipboard.writeText(code?.innerText ?? "");
        } catch {
          return;
        }

        copyButton.innerHTML = checkIcon + "<span>已复制</span>";
        copyButton.classList.add("is-copied");
        setTimeout(() => {
          copyButton.innerHTML = copyIcon + "<span>复制</span>";
          copyButton.classList.remove("is-copied");
        }, 1500);
      });
    }
  }
  enhanceCodeBlocks();

  /**
   * 文章里可嵌入的块：标签页（Tabs）与剧透（Spoiler）。
   * 写法与样式见 README「文章里可嵌入的块」和 base.css。
   * Steps 与 Collapse 分别用样式和原生 <details> 实现，不需要脚本。
   */
  function initContentBlocks() {
    for (const group of document.querySelectorAll("[data-tabs]")) {
      // 视图切换后脚本会重跑，处理过的不再重复生成标签栏
      if (group.dataset.ready === "true") continue;

      const panels = Array.from(group.querySelectorAll(":scope > [data-tab]"));
      if (panels.length < 2) continue;
      group.dataset.ready = "true";

      const list = document.createElement("div");
      list.className = "tabs-tablist";
      list.setAttribute("role", "tablist");

      panels.forEach((panel, index) => {
        panel.setAttribute("role", "tabpanel");
        panel.hidden = index !== 0;

        const button = document.createElement("button");
        button.type = "button";
        button.className = "tabs-tab";
        button.setAttribute("role", "tab");
        button.setAttribute("aria-selected", String(index === 0));
        button.textContent = panel.dataset.tab ?? "";
        button.addEventListener("click", () => {
          panels.forEach((item, i) => {
            item.hidden = i !== index;
            list.children[i].setAttribute("aria-selected", String(i === index));
          });
        });
        list.append(button);
      });

      group.prepend(list);
    }

    for (const spoiler of document.querySelectorAll(".spoiler")) {
      if (spoiler.dataset.bound === "true") continue;
      spoiler.dataset.bound = "true";
      spoiler.setAttribute("tabindex", "0");
      const toggle = () => spoiler.classList.toggle("is-revealed");
      spoiler.addEventListener("click", toggle);
      spoiler.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          toggle();
        }
      });
    }
  }
  initContentBlocks();
  document.addEventListener("astro:after-swap", initContentBlocks);

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );

  /** Image lightbox — click to expand, wheel to zoom, click/esc to close */
  let lightboxReady = false;
  function initLightbox() {
    const article = document.getElementById("article");
    if (!article || lightboxReady) return;
    lightboxReady = true;
    article.addEventListener("click", e => {
      const img = e.target.closest("img");
      if (!img) return;

      const overlay = document.createElement("div");
      overlay.className = "lightbox-overlay";
      const clone = img.cloneNode(true);
      clone.style.cursor = "grab";
      clone.style.transition = "transform 0.1s ease-out";
      const closeBtn = document.createElement("span");
      closeBtn.className = "lightbox-close";
      closeBtn.textContent = "×";
      overlay.appendChild(closeBtn);
      overlay.appendChild(clone);
      document.body.appendChild(overlay);
      document.body.style.overflow = "hidden";

      let scale = 1;
      const MIN = 0.5,
        MAX = 6,
        STEP = 0.15;

      function applyZoom() {
        clone.style.transform = `scale(${scale})`;
      }

      // Wheel zoom
      overlay.addEventListener(
        "wheel",
        e => {
          e.preventDefault();
          scale += e.deltaY < 0 ? STEP : -STEP;
          scale = Math.min(MAX, Math.max(MIN, scale));
          applyZoom();
        },
        { passive: false }
      );

      // Double-click reset
      overlay.addEventListener("dblclick", e => {
        if (e.target === overlay || e.target === closeBtn) return;
        scale = 1;
        applyZoom();
      });

      const close = () => {
        overlay.remove();
        document.body.style.overflow = "";
        document.removeEventListener("keydown", escHandler);
      };
      overlay.addEventListener("click", e => {
        if (e.target === overlay || e.target.closest(".lightbox-close"))
          close();
      });
      document.addEventListener("keydown", escHandler);
      function escHandler(e) {
        if (e.key === "Escape") close();
      }
    });
  }
  initLightbox();
  document.addEventListener("astro:after-swap", () => {
    lightboxReady = false;
    initLightbox();
  });

  /** Render Mermaid diagrams */
  async function renderMermaid() {
    const mermaidDivs = document.querySelectorAll(".mermaid");
    if (!mermaidDivs.length) return;

    const { default: mermaid } =
      await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
    mermaid.initialize({ startOnLoad: false, theme: "default" });
    await mermaid.run({ nodes: [...mermaidDivs] });
  }
  renderMermaid();
  document.addEventListener("astro:after-swap", renderMermaid);
</script>
