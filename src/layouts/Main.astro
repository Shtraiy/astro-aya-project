---
import Icon from "@components/Icon.astro";
import type { IconName } from "@components/Icon.astro";

interface Props {
  /** 页面标题 */
  pageTitle: string;
  pageDesc?: string;
  /** 标题旁的线性图标 */
  icon?: IconName;
  /** 图标色相 0-359，默认跟随站点强调色 */
  iconHue?: number;
  /** 这页的内容要不要进站内搜索索引（Pagefind 只收标了 data-pagefind-body 的页面） */
  pagefindBody?: boolean;
  /** 浏览型页面使用更宽的画布（收藏、追番、友链等） */
  wide?: boolean;
}

const {
  pageTitle,
  pageDesc,
  icon,
  iconHue,
  pagefindBody = false,
  wide = false,
} = Astro.props;
---

<main
  id="main-content"
  class:list={[wide && "is-wide"]}
  data-pagefind-body={pagefindBody ? "" : undefined}
>
  <div class="page-head">
    {
      icon && (
        <span
          class="page-head-icon"
          style={iconHue === undefined ? undefined : `--page-hue:${iconHue}`}
        >
          <Icon name={icon} size={22} />
        </span>
      )
    }
    <div class="page-head-text">
      <h1>{pageTitle}</h1>
      {pageDesc && <p>{pageDesc}</p>}
    </div>
  </div>
  <slot />
</main>

<style>
  @reference "../styles/base.css";
  #main-content {
    /* pt-12：以前这段留白是面包屑撑起来的，面包屑去掉后标题贴着页头分隔线了 */
    @apply mx-auto w-full px-4 pt-9 pb-10;
    max-width: var(--content-width);
    /* 让页面内的组件能按「实际可用宽度」自适应（例如统计条排几列） */
    container-type: inline-size;
  }
  /* 浏览型页面需要容纳网格和多列信息，正文页仍保持窄栏阅读宽度。 */
  #main-content.is-wide {
    --content-width: 72rem;
  }
  /* base.css 对所有 section 的默认限宽不应再次压缩宽版页面的内容。 */
  #main-content.is-wide > section {
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
  }
  .page-head {
    @apply mb-7 flex items-start gap-3 border-b pb-4 sm:mb-9;
    border-color: var(--pixel-line);
  }
  .page-head-icon {
    --page-hue: var(--accent-hue);
    @apply mt-1.5 grid size-6 flex-none place-items-center;
    color: hsl(var(--page-hue) 46% 41%);
  }
  /* 夜间底色深，浅色相才看得清 */
  :global(html[data-theme="dark"]) .page-head-icon {
    color: hsl(var(--page-hue) 52% 74%);
  }
  .page-head-text {
    @apply min-w-0;
  }
  .page-head-text h1 {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.6rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  /* 说明文字不再用斜体：长句斜体在中文里很别扭 */
  .page-head-text p {
    @apply mt-1.5 text-sm;
    color: rgb(var(--palette-muted-text));
    font-style: normal;
  }
</style>
