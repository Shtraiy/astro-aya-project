---
import { type CollectionEntry, getCollection } from "astro:content";
import PostDetails from "@layouts/PostDetails.astro";
import getSortedPosts from "@utils/getVisibleSortedPosts";
import postFilter from "@utils/postVisibility";
import normalizePostDatetimes from "@utils/normalizePostDatetimes";

export interface Props {
  post: CollectionEntry<"blog">;
  sortedPosts: CollectionEntry<"blog">[];
}

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const normalizedPosts = allPosts.map(normalizePostDatetimes);
  const sortedPosts = getSortedPosts(normalizedPosts);

  /*
    草稿：开发时照常生成页面，方便直接开 URL 预览（列表里仍然不显示）；
    正式构建时排除。只翻 draft 标记、不改这里，就能决定发不发。
  */
  const routablePosts = import.meta.env.DEV
    ? normalizedPosts.filter(({ data }) => !data.draft)
    : normalizedPosts.filter(postFilter);

  return routablePosts.map(post => ({
    params: { slug: post.id },
    props: { post, sortedPosts },
  }));
}

const { post, sortedPosts } = Astro.props;
---

<PostDetails post={post} posts={sortedPosts} />
