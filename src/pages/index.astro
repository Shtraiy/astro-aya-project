---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import BlogStats from "@components/BlogStats.astro";
import Section from "@components/Section.astro";
import getSortedPosts from "@utils/getVisibleSortedPosts";
import { SITE } from "@config";

const posts = getSortedPosts(await getCollection("blog"));
const featuredPosts = posts.filter(({ data }) => data.featured);
const recentPosts = posts
  .filter(({ data }) => !data.featured)
  .slice(0, SITE.postPerIndex);
---

<Layout>
  <Header />
  <main id="main-content" class="home">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">无言的鸟笼</h1>
      <p>
        这里没有固定的主题，像一片随意生长的花园。平时写些随笔、技术笔记和游记。
      </p>
      <div class="home-actions">
        <a class="browse-link" href="/posts/">浏览文章</a>
        <a
          class="rss-link"
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M19 20C19 11.7 12.3 5 4 5v2c7.2 0 13 5.8 13 13h2z"></path>
            <path d="M12 20h2c0-5.5-4.5-10-10-10v2c4.4 0 8 3.6 8 8z"></path>
            <circle cx="6" cy="18" r="2"></circle>
          </svg>
          RSS 订阅
        </a>
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <Section title="最近文章">
          <ul>
            {recentPosts.map(post => (
              <Card
                href={`/posts/${post.id}/`}
                frontmatter={post.data}
                body={post.body}
                secHeading={false}
              />
            ))}
          </ul>
        </Section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <Section title="置顶文章">
          <ul>
            {featuredPosts.map(post => (
              <Card
                href={`/posts/${post.id}/`}
                frontmatter={post.data}
                body={post.body}
                secHeading={false}
              />
            ))}
          </ul>
        </Section>
      )
    }

    <Section title="站点统计">
      <BlogStats />
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  @font-face {
    font-family: "SilentCage Title";
    src: url("/fonts/silentcage-title.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    unicode-range: U+65E0, U+7684, U+7B3C, U+8A00, U+9E1F;
  }

  .home {
    @apply mx-auto w-full px-4;
    max-width: var(--content-width);
    padding-bottom: clamp(2.5rem, 7vw, 5rem);
  }

  .home-intro {
    max-width: none;
    padding-block: clamp(2rem, 6vw, 4rem) clamp(2rem, 5vw, 3.25rem);
    padding-inline: 0;
  }

  .home-intro h1 {
    font-family: "SilentCage Title", var(--pixel-font);
    /* The 12px source grid scales evenly at 36px and 48px. */
    font-size: 48px;
    font-weight: 400;
    font-synthesis: none;
    line-height: 1.25;
    letter-spacing: 0;
    text-shadow: 2px 2px 0 var(--pixel-shadow);
  }

  .home-intro p {
    margin-block-start: 0.85rem;
    line-height: 1.85;
    text-wrap: balance;
    @apply text-muted-foreground;
  }

  .home-actions {
    @apply pixel-ui-text mt-6 flex flex-wrap items-center gap-x-5 gap-y-2;
  }

  @media (max-width: 38rem) {
    .home-intro h1 {
      font-size: 36px;
    }
  }

  .browse-link,
  .rss-link {
    @apply inline-flex min-h-11 items-center gap-1.5 text-primary underline-offset-4;
  }

  .browse-link {
    @apply underline decoration-1;
    text-decoration-color: color-mix(in srgb, currentColor 50%, transparent);
  }

  .browse-link:hover {
    text-decoration-color: currentColor;
  }

  .rss-link {
    @apply hover:underline;
  }

  .rss-link svg {
    @apply size-4 fill-current;
  }
</style>
