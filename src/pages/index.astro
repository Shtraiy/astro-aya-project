---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Card from "@components/Card";
import BlogStats from "@components/BlogStats.astro";
import Section from "@components/Section.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>Welcome to my SilentCage</h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
          ><path
            d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
          ></path><path
            d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
          ></path><circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS Feed</span>
      </a>
      <p>
        欢迎来到无言的鸟笼，这个站点没有固定的主题，更像是一片随意生长的花园，记录了一些随笔以及一些技术相关的内容
      </p>
    </section>

    {/* 下面几块统一走「左标签 · 右内容」版式，分区更清楚 */}
    <Section title="统计">
      <BlogStats blogStartDate={new Date("2020-11-30")} />
    </Section>

    {
      featuredPosts.length > 0 && (
        <Section title="置顶文章">
          <ul>
            {featuredPosts.map(post => (
              <Card
                href={`/posts/${post.id}/`}
                frontmatter={post.data}
                body={post.body}
                secHeading={false}
              />
            ))}
          </ul>
        </Section>
      )
    }

    {
      recentPosts.length > 0 && (
        <Section title="最近文章">
          <ul>
            {recentPosts.map(
              (post, index) =>
                index < SITE.postPerIndex && (
                  <Card
                    href={`/posts/${post.id}/`}
                    frontmatter={post.data}
                    body={post.body}
                    secHeading={false}
                  />
                )
            )}
          </ul>
          <div class="all-posts-btn-wrapper">
            <LinkButton
              href="/posts/"
              className="inline-flex items-center gap-1"
            >
              全部文章
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                class="h-5 w-5"
              >
                <path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z" />
              </svg>
            </LinkButton>
          </div>
        </Section>
      )
    }
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";
  /* ===== Hero Section ===== */
  #hero {
    @apply pt-8 pb-6;
  }
  #hero h1 {
    @apply my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl;
  }
  #hero .rss-link {
    @apply mb-6;
  }
  #hero .rss-icon {
    @apply fill-skin-accent mb-2 h-6 w-6 scale-110 sm:mb-3 sm:scale-125;
  }
  #hero p {
    @apply my-2;
  }

  /* ===== 分区（左标签 · 右内容，见 Section.astro） ===== */
  .all-posts-btn-wrapper {
    @apply mt-6 flex justify-end;
  }
</style>
