---
import Footer from "@components/Footer.astro";
import GitHubActivity from "@components/GitHubActivity.astro";
import Header from "@components/Header.astro";
import SectionBlock from "@components/SectionBlock.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import socialIcons from "@assets/socialIcons";
import { SITE, SOCIALS } from "@config";
import { ABOUT_SITE, FAVORITES, PROFILE } from "@data/profile";
import { fetchGitHubActivity, usernameFromUrl } from "@utils/githubActivity";

// 名片上的社交标签：直接读站点的社交配置，加一条链接就多一枚标签
const socials = SOCIALS.filter(social => social.active);

// GitHub 活跃度（构建时抓一次；抓不到就不渲染这一块）
const githubUrl = socials.find(social => social.name === "Github")?.href ?? "";
const githubUser = usernameFromUrl(githubUrl);
const githubActivity = await fetchGitHubActivity(githubUser);
---

<Layout
  title={`关于我 | ${SITE.title}`}
  description={`关于 ${SITE.author}：喜欢的作品和这个博客的来历。`}
>
  <Header activeNav="about" />

  <Main
    pageTitle="关于我"
    pageDesc="关于站长，以及这个站点的一些小事"
    icon="user"
    pagefindBody
  >
    <!-- ① 名片：头像 + 名字 + 一句话 + 标签 -->
    <section class="profile">
      <img
        class="profile-avatar"
        src={PROFILE.avatar}
        alt={`${PROFILE.name} 的头像`}
        loading="eager"
        decoding="async"
      />
      <div class="profile-text">
        <p class="profile-name">{PROFILE.name}</p>
        {PROFILE.alias && <p class="profile-alias">{PROFILE.alias}</p>}
        <p class="profile-tagline">{PROFILE.tagline}</p>
        <div class="profile-tags">
          {
            socials.map(social => (
              <a
                class="chip profile-chip"
                href={social.href}
                title={social.linkTitle}
                target={social.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  social.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                <Fragment set:html={socialIcons[social.name]} />
                <span>{social.name}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ② 自我介绍 -->
    <SectionBlock
      title="自我介绍"
      desc="几句话说说自己"
      icon="user"
      class="mt-9"
    >
      {PROFILE.intro.map(paragraph => <p class="prose-line">{paragraph}</p>)}
    </SectionBlock>

    <!-- ③ 喜欢的东西 -->
    <SectionBlock title="喜欢的东西" desc="一些一直喜欢的作品" icon="heart">
      <dl class="fact-list">
        {
          FAVORITES.map(item => (
            <div class="fact-row">
              <dt>{item.label}</dt>
              <dd>
                {item.href ? <a href={item.href}>{item.value}</a> : item.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </SectionBlock>

    <!-- ④ 关于本站 -->
    <SectionBlock title="关于本站" desc="这个站点的一些小事" icon="book">
      <dl class="fact-list">
        {
          ABOUT_SITE.map(item => (
            <div class="fact-row">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </SectionBlock>

    {
      githubActivity && (
        <SectionBlock
          title="GitHub 活跃度"
          desc={`${githubUser} 过去一年的提交`}
          icon="activity"
        >
          <GitHubActivity data={githubActivity} username={githubUser} />
        </SectionBlock>
      )
    }
  </Main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  /* ── ① 名片 ── */
  .profile {
    display: flex;
    align-items: center;
    gap: 1.125rem;
    max-width: none;
    padding-inline: 0;
  }
  @media (max-width: 30rem) {
    .profile {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .profile-avatar {
    flex: none;
    width: 5.5rem;
    height: 5.5rem;
    margin: 0;
    border: 1px solid var(--pixel-line);
    object-fit: cover;
    /* 立绘构图是人像靠上，裁成方块时往上偏一点才不切掉脸 */
    object-position: 50% 12%;
    background-color: rgb(var(--palette-fill));
  }
  .profile-text {
    min-width: 0;
  }
  .profile-name {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgb(var(--palette-text));
  }
  .profile-alias {
    margin: 0.125rem 0 0;
    font-family: var(--pixel-font);
    font-size: 0.9375rem;
    color: rgb(var(--palette-muted-text));
  }
  .profile-tagline {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgb(var(--palette-text));
  }
  .profile-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }
  .profile-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    padding-inline: 0;
    border-color: transparent;
    background-color: transparent;
    font-size: 0.75rem;
    text-decoration: none;
  }
  a.profile-chip:hover {
    background-color: transparent;
    border-color: transparent;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .profile-chip svg {
    width: 0.875rem;
    height: 0.875rem;
    flex: none;
    fill: currentColor;
  }

  /* ── ② 自我介绍 ── */
  .prose-line {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.85;
    color: rgb(var(--palette-text));
  }
  .prose-line:last-child {
    margin-bottom: 0;
  }

  /* ── ③④ 两列表 ── */
  .fact-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
  }
  .fact-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .fact-row dt {
    flex: none;
    width: 4.5rem;
    text-align: right;
    font-size: 0.8125rem;
    color: rgb(var(--palette-muted-text));
  }
  .fact-row dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgb(var(--palette-text));
  }
  .fact-row dd a {
    color: rgb(var(--palette-accent));
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      rgb(var(--palette-accent)) 40%,
      transparent
    );
    text-underline-offset: 0.2em;
  }
  .fact-row dd a:hover {
    text-decoration: none;
  }
</style>
