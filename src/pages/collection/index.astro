---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Icon from "@components/Icon.astro";
import StatsStrip from "@components/StatsStrip.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import { SITE } from "@config";
import { loadCollection } from "@utils/collectionData";

/**
 * Navidrome 音乐收藏。
 *
 * 数据是构建时快照（src/data/navidrome.json，由 `npm run sync:navidrome` 生成），
 * 所以封面墙与统计在构建期就渲染好了，页面本身是静态的。
 *
 * 播放交给 Layout 里的常驻播放器（MusicPlayer.astro）：这一页只负责给专辑卡打上
 * `data-album-open="<专辑 id>"`，再放两个全库入口（顺序 / 随机）。
 */
const { syncedAt, albums } = loadCollection();

const slugify = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^\p{Letter}\p{Number}]+/gu, "-")
    .replace(/^-+|-+$/g, "");

const formatDuration = (seconds: number) => {
  const minutes = Math.round(seconds / 60);
  if (minutes < 60) return `${minutes} 分钟`;
  const hours = Math.floor(minutes / 60);
  const rest = minutes % 60;
  return rest === 0 ? `${hours} 小时` : `${hours} 小时 ${rest} 分`;
};

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

/** 没有封面时用专辑名生成一个稳定的色相，避免整页灰扑扑 */
const hueOf = (value: string) => {
  let hash = 0;
  for (const char of value) hash = (hash * 31 + char.codePointAt(0)!) % 360;
  return hash;
};

const artists = [
  ...albums
    .reduce((map, album) => {
      const key = album.artist || "未知艺术家";
      map.set(key, (map.get(key) ?? 0) + 1);
      return map;
    }, new Map<string, number>())
    .entries(),
]
  .map(([name, count]) => ({ name, slug: slugify(name), count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const totalSongs = albums.reduce((sum, a) => sum + (a.songCount ?? 0), 0);
const totalDuration = albums.reduce((sum, a) => sum + (a.duration ?? 0), 0);

/** 艺术家药丸默认只展示前 N 个，库里几十个艺术家时不至于把封面墙顶下去 */
const CHIP_LIMIT = 12;
const hiddenArtists = Math.max(0, artists.length - CHIP_LIMIT);

const stats = [
  { value: albums.length.toString(), label: "张专辑" },
  { value: totalSongs.toString(), label: "首曲目" },
  {
    value: totalDuration > 0 ? formatDuration(totalDuration) : "—",
    label: "总时长",
  },
  { value: syncedAt ? formatDate(syncedAt) : "未同步", label: "同步于" },
];
---

<Layout title={`音乐收藏 | ${SITE.title}`}>
  <Header activeNav="collection" />

  <Main
    pageTitle="音乐收藏"
    pageDesc="来自 Navidrome 的音乐库快照 · 点封面即可播放"
    icon="headphones"
    pagefindBody
  >
    <StatsStrip items={stats} class="mb-8" />

    {
      albums.length === 0 ? (
        <section class="collection-empty">
          <p>还没有同步数据。三步就能把这个页面填满：</p>
          <ol>
            <li>
              把 <code>.env.example</code> 复制成 <code>.env</code>，填上
              Navidrome 地址和一个只读账号
            </li>
            <li>
              运行 <code>npm run sync:navidrome</code>
            </li>
            <li>重新构建站点</li>
          </ol>
        </section>
      ) : (
        <>
          {artists.length > 1 && (
            <div class="album-filter">
              <p class="album-filter-title">
                <Icon name="hashtag" class="album-filter-icon" />
                <span>艺术家</span>
              </p>
              <ul class="album-chips">
                <li>
                  <button
                    type="button"
                    class="chip is-current"
                    data-artist-filter="all"
                  >
                    全部<span class="chip-count">{albums.length}</span>
                  </button>
                </li>
                {artists.map((artist, index) => (
                  <li hidden={index >= CHIP_LIMIT} data-artist-chip>
                    <button
                      type="button"
                      class="chip"
                      data-artist-filter={artist.slug}
                    >
                      {artist.name}
                      <span class="chip-count">{artist.count}</span>
                    </button>
                  </li>
                ))}
                {hiddenArtists > 0 && (
                  <li>
                    <button
                      type="button"
                      class="chip album-chips-toggle"
                      data-artist-toggle
                      aria-expanded="false"
                    >
                      展开全部 +{hiddenArtists}
                    </button>
                  </li>
                )}
              </ul>
            </div>
          )}

          {/* 这一行是页面控件（搜索 / 排序 / 播放全部），不该进站内搜索索引 */}
          <div class="album-tools" data-pagefind-ignore>
            <div class="album-search">
              <Icon name="search" class="album-search-icon" />
              <input
                type="search"
                class="album-search-input"
                data-album-search
                placeholder="搜专辑 / 艺术家 / 曲名"
                aria-label="搜索专辑、艺术家或曲名"
                autocomplete="off"
              />
              <button
                type="button"
                class="album-search-clear"
                data-album-search-clear
                aria-label="清除搜索"
                hidden
              >
                ✕
              </button>
            </div>
            <label class="album-sort">
              <span class="album-sort-label">排序</span>
              <select class="album-sort-select" data-album-sort>
                <option value="default">默认</option>
                <option value="name">专辑名</option>
                <option value="artist">艺术家</option>
                <option value="year">年份</option>
                <option value="songs">曲目数</option>
              </select>
            </label>
            <span class="album-count" data-album-count />

            <div class="album-actions">
              <button
                type="button"
                class="album-action album-action-play"
                data-play-all
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 5v14l12-7z" />
                </svg>
                <span>全部播放</span>
                <span class="album-action-note">{totalSongs} 首</span>
              </button>
              <button type="button" class="album-action" data-play-all-shuffle>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M16 3h5v5" />
                  <path d="M4 20L21 3" />
                  <path d="M21 16v5h-5" />
                  <path d="M15 15l6 6" />
                  <path d="M4 4l5 5" />
                </svg>
                <span>随机播放全部</span>
              </button>
            </div>
          </div>

          <ul class="album-grid" data-album-grid>
            {albums.map((album, index) => {
              const artist = album.artist || "未知艺术家";
              const meta = [
                album.year ? String(album.year) : null,
                album.songCount ? `${album.songCount} 首` : null,
              ].filter(Boolean);
              // 没有曲目的专辑点不动（播放器那边也是按 id 找专辑，不再传索引）
              const playable = album.tracks.length > 0;

              return (
                <li
                  class="album"
                  data-album={album.id}
                  data-name={album.name}
                  data-artist={slugify(artist)}
                  data-artist-name={artist}
                  data-year={album.year ? String(album.year) : ""}
                  data-songs={String(album.songCount ?? 0)}
                  style={`--album-hue:${hueOf(album.name)}`}
                >
                  {playable && (
                    <button
                      type="button"
                      class="album-enqueue"
                      data-album-enqueue={album.id}
                      title="加入队列"
                      aria-label={`把《${album.name}》加入队列`}
                    >
                      <svg
                        class="icon-plus"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M12 5v14" />
                        <path d="M5 12h14" />
                      </svg>
                      <svg
                        class="icon-check"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M5 12l5 5l10 -10" />
                      </svg>
                    </button>
                  )}

                  <button
                    class="album-link"
                    title={`${album.name} — ${artist}`}
                    type="button"
                    data-album-open={playable ? album.id : undefined}
                    disabled={!playable}
                  >
                    <span class="album-cover">
                      {album.cover ? (
                        <img
                          src={album.cover}
                          alt=""
                          loading={index < 12 ? "eager" : "lazy"}
                          fetchpriority={index < 12 ? "high" : undefined}
                          decoding="async"
                        />
                      ) : (
                        <span class="album-cover-fallback" aria-hidden="true">
                          {album.name.slice(0, 1)}
                        </span>
                      )}

                      {album.starred && (
                        <span class="album-star" title="已收藏">
                          ★
                        </span>
                      )}

                      {playable && (
                        <span class="album-hover" aria-hidden="true">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                          >
                            <path d="M8 5v14l11-7z" />
                          </svg>
                        </span>
                      )}
                    </span>

                    <span class="album-name">{album.name}</span>
                    <span class="album-artist">{artist}</span>
                    {meta.length > 0 && (
                      <span class="album-meta">{meta.join(" · ")}</span>
                    )}
                  </button>

                  {/* 搜索命中曲名时由脚本填进来：点一行直接播那一首 */}
                  <span class="album-hits" data-album-hits hidden />
                </li>
              );
            })}
          </ul>

          <p class="album-empty" data-album-empty data-pagefind-ignore hidden>
            没有匹配的专辑。
            <button type="button" class="album-empty-reset" data-album-reset>
              清除筛选
            </button>
          </p>
        </>
      )
    }
  </Main>

  <Footer />
</Layout>

<script>
  import { initCollectionFilter } from "@utils/collectionFilter";

  /*
    收藏页的交互（艺术家药丸 + 搜索 + 排序 +「展开全部」）都收在 collectionFilter 里，
    那边自己挡住重复绑定。这里用 astro:page-load 是因为站内客户端跳转进来时，
    模块脚本不会重新执行。
  */
  initCollectionFilter();
  document.addEventListener("astro:page-load", initCollectionFilter);
</script>

<style>
  @reference "../../styles/base.css";

  /* 顶部统计条走 <StatsStrip>，样式在组件里，和首页 / 追番页共用 */
  /* ── 艺术家筛选（横向药丸条） ── */
  .album-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    margin-bottom: 1.5rem;
  }
  .album-filter-title {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    @apply text-foreground;
  }
  .album-filter-icon {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
  }
  .album-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .album-chips-toggle {
    border-style: dashed;
  }

  /* ── 工具行：搜索 + 排序 + 全库入口（播放动作在常驻播放器里） ── */
  .album-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1.5rem;
  }
  .album-search {
    position: relative;
    display: flex;
    flex: 1 1 13rem;
    align-items: center;
    max-width: 20rem;
  }
  .album-search-icon {
    position: absolute;
    left: 0.6875rem;
    width: 0.875rem;
    height: 0.875rem;
    color: rgb(var(--palette-muted-text));
    pointer-events: none;
  }
  .album-search-input {
    width: 100%;
    padding: 0.4375rem 2rem;
    border: 1px solid rgb(var(--palette-border));
    border-radius: 999px;
    background-color: rgb(var(--palette-fill));
    color: rgb(var(--palette-text));
    font-family: inherit;
    font-size: 0.8125rem;
    line-height: 1.2;
  }
  .album-search-input:focus {
    border-color: rgb(var(--palette-accent));
    outline: none;
  }
  /* 自己画清除按钮，两个都留会出现两个 ✕ */
  .album-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    display: none;
  }
  .album-search-clear {
    position: absolute;
    right: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: none;
    color: rgb(var(--palette-muted-text));
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
  }
  .album-search-clear:hover {
    background-color: rgb(var(--palette-muted));
    color: rgb(var(--palette-text));
  }
  .album-search-clear[hidden] {
    display: none;
  }
  .album-sort {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    font-size: 0.75rem;
    color: rgb(var(--palette-muted-text));
  }
  .album-sort-select {
    padding: 0.4375rem 0.5rem;
    border: 1px solid rgb(var(--palette-border));
    border-radius: 999px;
    background-color: rgb(var(--palette-fill));
    color: rgb(var(--palette-text));
    font-family: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .album-sort-select:focus {
    border-color: rgb(var(--palette-accent));
    outline: none;
  }
  .album-count {
    font-size: 0.75rem;
    color: rgb(var(--palette-muted-text));
  }
  .album-count:empty {
    display: none;
  }

  /* ── 全库入口：顺序播放 / 随机播放全部 ── */
  .album-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: auto;
  }
  .album-action {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4375rem 0.75rem;
    border: 1px solid rgb(var(--palette-border));
    border-radius: 999px;
    background-color: rgb(var(--palette-fill));
    color: rgb(var(--palette-text));
    font-family: inherit;
    font-size: 0.8125rem;
    line-height: 1.2;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .album-action:hover {
    border-color: rgb(var(--palette-accent));
    color: rgb(var(--palette-accent));
  }
  .album-action:focus-visible {
    outline: 2px dashed rgb(var(--palette-accent));
    outline-offset: 0.25rem;
  }
  .album-action svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* 播放键是实心三角，随机键是线稿，两个图标的画法不一样 */
  .album-action-play svg {
    fill: currentColor;
    stroke: none;
  }
  .album-action-note {
    font-size: 0.75rem;
    color: rgb(var(--palette-muted-text));
  }

  /* ── 封面墙：对齐 Navidrome 的专辑网格 ── */
  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 1rem 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .album-grid {
      grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
      gap: 1.125rem 0.75rem;
    }
  }
  .album[hidden] {
    display: none;
  }
  /* 「加入队列」按钮定位在卡片上（落点＝封面右上角） */
  .album {
    position: relative;
  }
  /* 卡片右上角的「加入队列」：往队列里追加这张专辑，不打断正在放的那首。
     定位在 <li> 上，落点就是封面右上角；收藏星标因此挪到左上角（见 .album-star）。 */
  .album-enqueue {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: rgb(0 0 0 / 0.48);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    backdrop-filter: blur(4px);
    transition:
      opacity 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }
  .album:hover .album-enqueue,
  .album-enqueue:focus-visible {
    opacity: 1;
  }
  .album-enqueue:hover {
    background-color: rgb(0 0 0 / 0.72);
    transform: scale(1.06);
  }
  .album-enqueue svg {
    width: 0.9375rem;
    height: 0.9375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .album-enqueue .icon-check {
    display: none;
  }
  /* 加好了：图标换成 ✓，按钮保持可见 1.6 秒（面板收起来时也能看到反馈） */
  .album-enqueue.is-added {
    opacity: 1;
    background-color: rgb(var(--palette-accent));
  }
  .album-enqueue.is-added .icon-plus {
    display: none;
  }
  .album-enqueue.is-added .icon-check {
    display: block;
  }
  /* 触屏没有 hover，直接常显（半透明，不抢封面） */
  @media (hover: none) {
    .album-enqueue {
      opacity: 0.9;
    }
  }

  .album-link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font-family: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .album-link:disabled {
    cursor: default;
  }
  .album-link:not(:disabled):focus-visible {
    outline: 2px dashed rgb(var(--palette-accent));
    outline-offset: 0.25rem;
    border-radius: 0.75rem;
  }

  .album-cover {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: rgb(var(--palette-muted));
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .album-link:hover .album-cover {
    transform: translateY(-2px) scale(1.012);
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.22);
  }
  .album-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 没有封面时用专辑名生成的色相兜底 */
  .album-cover-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 2rem;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(
      135deg,
      hsl(var(--album-hue, 210) 48% 58%),
      hsl(calc(var(--album-hue, 210) + 28) 48% 42%)
    );
  }

  .album-star {
    position: absolute;
    top: 0.375rem;
    /* 右上角让给「加入队列」按钮 */
    left: 0.375rem;
    padding: 0 0.3125rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: #fff;
    background-color: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(4px);
  }
  /* 搜索命中曲名时列出来的可点行（脚本填入，最多两行） */
  .album-hits {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: 0.25rem;
  }
  .album-hits[hidden] {
    display: none;
  }
  .album-hit {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    color: rgb(var(--palette-accent));
    font-family: inherit;
    font-size: 0.6875rem;
    line-height: 1.35;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
  }
  .album-hit:hover {
    text-decoration: underline;
  }
  /* 悬停遮罩：点封面是去 Navidrome 打开，不是站内播放 */
  .album-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgb(0 0 0 / 0.34);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .album-hover svg {
    width: 2.25rem;
    height: 2.25rem;
    fill: #fff;
    stroke: none;
    filter: drop-shadow(0 1px 4px rgb(0 0 0 / 0.45));
  }
  .album-link:hover .album-hover {
    opacity: 1;
  }

  .album-name {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    @apply text-foreground;
  }
  .album-artist {
    font-size: 0.75rem;
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
