---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Icon from "@components/Icon.astro";
import CollectionPlayer from "@components/CollectionPlayer.astro";
import StatsStrip from "@components/StatsStrip.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import { SITE } from "@config";
import { readFileSync } from "node:fs";
import path from "node:path";

/**
 * Navidrome 音乐收藏。
 *
 * 数据是构建时快照（src/data/navidrome.json，由 `npm run sync:navidrome`
 * 生成），所以页面本身是纯静态的，运行时不依赖 Navidrome，前端也没有任何凭据。
 * 页面上不做播放：点专辑卡片会跳到 Navidrome 自己的页面播放。
 */
interface Album {
  id: string;
  name: string;
  artist: string;
  year: number | null;
  genre: string | null;
  songCount: number | null;
  duration: number | null;
  starred: boolean;
  cover: string | null;
  tracks: {
    id: string;
    title: string;
    track: number | null;
    duration: number | null;
  }[];
}

interface CollectionData {
  serverUrl: string;
  syncedAt: string | null;
  stream: { user: string; token: string; salt: string; client: string };
  albums: Album[];
}

/**
 * 数据快照由 `npm run sync:navidrome` 生成。这里读文件而不是 `import` JSON，
 * 是为了让文件缺失时退回空状态（页面显示导入引导），而不是整个构建失败 ——
 * 这样数据文件提交与否、CI 上有没有，都不会把站点构建搞挂。
 */
const loadCollection = (): CollectionData => {
  try {
    const file = path.join(process.cwd(), "src", "data", "navidrome.json");
    return JSON.parse(readFileSync(file, "utf8")) as CollectionData;
  } catch {
    return {
      serverUrl: "",
      syncedAt: null,
      stream: { user: "", token: "", salt: "", client: "" },
      albums: [],
    };
  }
};

const { serverUrl, syncedAt, stream, albums } = loadCollection();

// 播放窗只收有曲目的专辑，索引要和下面按钮里的 data-album-open 对上
const playableIds = albums
  .filter(album => album.tracks.length > 0)
  .map(album => album.id);

const slugify = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^\p{Letter}\p{Number}]+/gu, "-")
    .replace(/^-+|-+$/g, "");

const formatDuration = (seconds: number) => {
  const minutes = Math.round(seconds / 60);
  if (minutes < 60) return `${minutes} 分钟`;
  const hours = Math.floor(minutes / 60);
  const rest = minutes % 60;
  return rest === 0 ? `${hours} 小时` : `${hours} 小时 ${rest} 分`;
};

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

/** 没有封面时用专辑名生成一个稳定的色相，避免整页灰扑扑 */
const hueOf = (value: string) => {
  let hash = 0;
  for (const char of value) hash = (hash * 31 + char.codePointAt(0)!) % 360;
  return hash;
};

const artists = [
  ...albums
    .reduce((map, album) => {
      const key = album.artist || "未知艺术家";
      map.set(key, (map.get(key) ?? 0) + 1);
      return map;
    }, new Map<string, number>())
    .entries(),
]
  .map(([name, count]) => ({ name, slug: slugify(name), count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const totalSongs = albums.reduce((sum, a) => sum + (a.songCount ?? 0), 0);
const totalDuration = albums.reduce((sum, a) => sum + (a.duration ?? 0), 0);

/** 艺术家药丸默认只展示前 N 个，库里几十个艺术家时不至于把封面墙顶下去 */
const CHIP_LIMIT = 12;
const hiddenArtists = Math.max(0, artists.length - CHIP_LIMIT);

const stats = [
  { value: albums.length.toString(), label: "张专辑" },
  { value: totalSongs.toString(), label: "首曲目" },
  {
    value: totalDuration > 0 ? formatDuration(totalDuration) : "—",
    label: "总时长",
  },
  { value: syncedAt ? formatDate(syncedAt) : "未同步", label: "同步于" },
];
---

<Layout title={`音乐收藏 | ${SITE.title}`}>
  <Header activeNav="collection" />

  <Main
    pageTitle="音乐收藏"
    pageDesc="来自 Navidrome 的音乐库快照 · 点封面即可播放"
    icon="headphones"
  >
    <StatsStrip items={stats} class="mb-8" />

    {
      albums.length === 0 ? (
        <section class="collection-empty">
          <p>还没有同步数据。三步就能把这个页面填满：</p>
          <ol>
            <li>
              把 <code>.env.example</code> 复制成 <code>.env</code>，填上
              Navidrome 地址和一个只读账号
            </li>
            <li>
              运行 <code>npm run sync:navidrome</code>
            </li>
            <li>重新构建站点</li>
          </ol>
        </section>
      ) : (
        <>
          {artists.length > 1 && (
            <div class="album-filter">
              <p class="album-filter-title">
                <Icon name="hashtag" class="album-filter-icon" />
                <span>艺术家</span>
              </p>
              <ul class="album-chips">
                <li>
                  <button
                    type="button"
                    class="chip is-current"
                    data-artist-filter="all"
                  >
                    全部<span class="chip-count">{albums.length}</span>
                  </button>
                </li>
                {artists.map((artist, index) => (
                  <li hidden={index >= CHIP_LIMIT} data-artist-chip>
                    <button
                      type="button"
                      class="chip"
                      data-artist-filter={artist.slug}
                    >
                      {artist.name}
                      <span class="chip-count">{artist.count}</span>
                    </button>
                  </li>
                ))}
                {hiddenArtists > 0 && (
                  <li>
                    <button
                      type="button"
                      class="chip album-chips-toggle"
                      data-artist-toggle
                      aria-expanded="false"
                    >
                      展开全部 +{hiddenArtists}
                    </button>
                  </li>
                )}
              </ul>
            </div>
          )}

          <ul class="album-grid">
            {albums.map((album, index) => {
              const artist = album.artist || "未知艺术家";
              const meta = [
                album.year ? String(album.year) : null,
                album.songCount ? `${album.songCount} 首` : null,
              ].filter(Boolean);
              const playableIndex = playableIds.indexOf(album.id);

              return (
                <li
                  class="album"
                  data-artist={slugify(artist)}
                  style={`--album-hue:${hueOf(album.name)}`}
                >
                  <button
                    class="album-link"
                    title={`${album.name} — ${artist}`}
                    type="button"
                    data-album-open={
                      playableIndex >= 0 ? String(playableIndex) : undefined
                    }
                    disabled={playableIndex < 0}
                  >
                    <span class="album-cover">
                      {album.cover ? (
                        <img
                          src={album.cover}
                          alt=""
                          loading={index < 12 ? "eager" : "lazy"}
                          fetchpriority={index < 12 ? "high" : undefined}
                          decoding="async"
                        />
                      ) : (
                        <span class="album-cover-fallback" aria-hidden="true">
                          {album.name.slice(0, 1)}
                        </span>
                      )}

                      {album.starred && (
                        <span class="album-star" title="已收藏">
                          ★
                        </span>
                      )}

                      {playableIndex >= 0 && (
                        <span class="album-hover" aria-hidden="true">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                          >
                            <path d="M8 5v14l11-7z" />
                          </svg>
                        </span>
                      )}
                    </span>

                    <span class="album-name">{album.name}</span>
                    <span class="album-artist">{artist}</span>
                    {meta.length > 0 && (
                      <span class="album-meta">{meta.join(" · ")}</span>
                    )}
                  </button>
                </li>
              );
            })}
          </ul>
        </>
      )
    }
  </Main>

  <CollectionPlayer serverUrl={serverUrl} stream={stream} albums={albums} />

  <Footer />
</Layout>

<script>
  import { initChipFilter } from "@utils/chipFilter";

  /*
    收藏页的交互：艺术家筛选（共用工具）+「展开全部」药丸。
    用 astro:page-load 而不是只在模块顶层跑一次 —— 站内客户端跳转进来时，
    模块脚本不会重新执行。
  */
  function initArtistChipsToggle() {
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-artist-toggle]"
    );
    if (!toggle || toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";

    // 「展开全部」：默认收起的那批艺术家药丸
    const extraChips = Array.from(
      document.querySelectorAll<HTMLElement>("[data-artist-chip]")
    );
    const toggleLabel = toggle.textContent ?? "";
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      for (const chip of extraChips) chip.hidden = expanded;
      toggle.textContent = expanded ? toggleLabel : "收起";
    });
  }

  function initCollectionPage() {
    initChipFilter({
      buttonSelector: "[data-artist-filter]",
      buttonKey: "artistFilter",
      itemSelector: "[data-artist]",
      itemKey: "artist",
    });
    initArtistChipsToggle();
  }

  initCollectionPage();
  document.addEventListener("astro:page-load", initCollectionPage);
</script>

<style>
  @reference "../../styles/base.css";

  /* 顶部统计条走 <StatsStrip>，样式在组件里，和首页 / 追番页共用 */
  /* ── 艺术家筛选（横向药丸条） ── */
  .album-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    margin-bottom: 1.5rem;
  }
  .album-filter-title {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    @apply text-foreground;
  }
  .album-filter-icon {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
  }
  .album-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .album-chips-toggle {
    border-style: dashed;
  }

  /* ── 封面墙：对齐 Navidrome 的专辑网格 ── */
  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 1rem 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .album-grid {
      grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
      gap: 1.125rem 0.75rem;
    }
  }
  .album[hidden] {
    display: none;
  }
  .album-link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font-family: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .album-link:disabled {
    cursor: default;
  }
  .album-link:not(:disabled):focus-visible {
    outline: 2px dashed rgb(var(--palette-accent));
    outline-offset: 0.25rem;
    border-radius: 0.75rem;
  }

  .album-cover {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: rgb(var(--palette-muted));
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .album-link:hover .album-cover {
    transform: translateY(-2px) scale(1.012);
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.22);
  }
  .album-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 没有封面时用专辑名生成的色相兜底 */
  .album-cover-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 2rem;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(
      135deg,
      hsl(var(--album-hue, 210) 48% 58%),
      hsl(calc(var(--album-hue, 210) + 28) 48% 42%)
    );
  }

  .album-star {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    padding: 0 0.3125rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: #fff;
    background-color: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(4px);
  }
  /* 悬停遮罩：点封面是去 Navidrome 打开，不是站内播放 */
  .album-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgb(0 0 0 / 0.34);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .album-hover svg {
    width: 2.25rem;
    height: 2.25rem;
    fill: #fff;
    stroke: none;
    filter: drop-shadow(0 1px 4px rgb(0 0 0 / 0.45));
  }
  .album-link:hover .album-hover {
    opacity: 1;
  }

  .album-name {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    @apply text-foreground;
  }
  .album-artist {
    font-size: 0.75rem;
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    @apply text-muted-foreground;
  }
  .album-meta {
    font-size: 0.6875rem;
    line-height: 1.3;
    @apply text-muted-foreground;
    opacity: 0.7;
  }

  /* ── 未同步时的引导 ── */
  .collection-empty {
    padding: 1.25rem 1.375rem;
    border: 1px dashed rgb(var(--palette-border));
    border-radius: 1rem;
    @apply text-muted-foreground;
    font-size: 0.9375rem;
  }
  .collection-empty p {
    margin: 0 0 0.75rem;
    color: rgb(var(--palette-text));
  }
  .collection-empty ol {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .collection-empty code {
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    font-size: 0.875em;
    background-color: rgb(var(--palette-muted));
    @apply text-foreground;
  }

  /*
    栏宽跟全站保持一致（48rem），不要单独放宽 ——
    之前放到 72rem 后，在这页内容明显比导航栏宽，看起来像"跑到边界外面"。
    宽度受限就靠把格子做小来保证封面密度（见 .album-grid）。
  */
</style>
