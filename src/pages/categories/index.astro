---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Icon from "@components/Icon.astro";
import { SITE } from "@config";
import { sortedCategories } from "@data/categories";
import getSortedPosts from "@utils/getSortedPosts";

/**
 * 分类总览：每个栏目一张卡（文章数 + 说明 + 最近一篇）。
 * 空栏目也照常列出来，避免"配置里有、页面上没有"的困惑。
 */
const posts = getSortedPosts(await getCollection("blog"));

const categories = sortedCategories().map(category => {
  const inCategory = posts.filter(post => post.data.category === category.name);
  return {
    ...category,
    count: inCategory.length,
    latest: inCategory[0],
  };
});
---

<Layout title={`分类 | ${SITE.title}`}>
  <Header activeNav="categories" />
  <Main
    pageTitle="分类"
    pageDesc="按栏目浏览 · 分类互斥，想按关键词找文章请去标签页"
    icon="folder"
  >
    <ul class="category-grid">
      {
        categories.map(category => (
          <li>
            {category.count > 0 ? (
              <a
                class="category-card"
                href={`/categories/${category.name}/`}
                style={`--cat-hue:${category.hue}`}
              >
                <span class="category-card-icon">
                  <Icon name={category.icon} size={20} />
                </span>
                <span class="category-card-body">
                  <span class="category-card-head">
                    <span class="category-card-name">{category.name}</span>
                    <span class="category-card-count">{category.count} 篇</span>
                  </span>
                  <span class="category-card-desc">{category.desc}</span>
                  {category.latest && (
                    <span class="category-card-latest">
                      最新：{category.latest.data.title}
                    </span>
                  )}
                </span>
              </a>
            ) : (
              <div
                class="category-card is-empty"
                style={`--cat-hue:${category.hue}`}
              >
                <span class="category-card-icon">
                  <Icon name={category.icon} size={20} />
                </span>
                <span class="category-card-body">
                  <span class="category-card-head">
                    <span class="category-card-name">{category.name}</span>
                    <span class="category-card-count">还没有文章</span>
                  </span>
                  <span class="category-card-desc">{category.desc}</span>
                </span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>

<style>
  @reference "../../styles/base.css";

  .category-grid {
    @apply m-0 flex list-none flex-col gap-4 p-0;
  }
  .category-card {
    /* 每个分类的图标色、悬停底色都从色相派生，深浅色各自取明度 */
    --cat-color: hsl(var(--cat-hue) 62% 41%);
    @apply flex items-start gap-4 rounded-2xl border p-4 no-underline transition-colors;
    border-color: rgb(var(--palette-border));
    background-color: rgb(var(--palette-fill));
  }
  :global(html[data-theme="dark"]) .category-card {
    --cat-color: hsl(var(--cat-hue) 78% 72%);
  }
  a.category-card:hover {
    border-color: color-mix(in srgb, var(--cat-color) 45%, transparent);
    background-color: color-mix(
      in srgb,
      rgb(var(--palette-muted)) 55%,
      transparent
    );
  }
  .category-card.is-empty {
    opacity: 0.6;
  }
  .category-card-icon {
    @apply grid size-10 flex-none place-items-center rounded-xl;
    color: var(--cat-color);
    background-color: color-mix(in srgb, var(--cat-color) 13%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat-color) 30%, transparent);
  }
  .category-card-body {
    @apply flex min-w-0 flex-col gap-1;
  }
  .category-card-head {
    @apply flex flex-wrap items-center gap-x-2 gap-y-1;
  }
  .category-card-name {
    @apply text-base font-semibold;
    color: rgb(var(--palette-text));
  }
  .category-card-count {
    @apply text-xs tabular-nums;
    color: var(--cat-color);
  }
  .category-card-desc {
    @apply text-sm;
    color: rgb(var(--palette-muted-text));
  }
  .category-card-latest {
    @apply truncate text-xs;
    color: rgb(var(--palette-muted-text));
    opacity: 0.85;
  }
</style>
