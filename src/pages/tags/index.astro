---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import TagCloud from "@components/TagCloud.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import { SITE } from "@config";
---

<Layout title={`Tags | ${SITE.title}`}>
  <Header activeNav="tags" />
  <Main
    pageTitle="笼中标签"
    pageDesc="字号越大，说明这个标签下的文章越多 · 点任意标签查看该主题下的文章"
    icon="hashtag"
  >
    <p class="tag-page-hint">
      标签是关键词，一篇文章可以有很多个；想按栏目浏览就去<a href="/categories/"
        >分类</a
      >。
    </p>
    <TagCloud variant="page" />
  </Main>
  <Footer />
</Layout>

<style>
  @reference "../../styles/base.css";

  /* 标签云自己带外边距节奏，这里只把篇幅拉开一点 */
  #main-content {
    padding-bottom: 4rem;
  }
  /* 分类入口提示：压在标签云上方，比正文小一档 */
  .tag-page-hint {
    @apply text-muted-foreground m-0 mb-7 text-sm;
  }
  .tag-page-hint a {
    @apply text-primary underline-offset-2 hover:underline;
  }
</style>
