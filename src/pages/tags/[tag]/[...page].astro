---
import { getCollection } from "astro:content";
import TagPosts from "@layouts/TagPosts.astro";
import getUniqueTags from "@utils/getUniqueTags";
import getPostsByTag from "@utils/getPostsByTag";
import type { GetStaticPathsOptions, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { SITE } from "@config";
import { RETIRED_TAGS, categoryPath } from "@data/retiredTags";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  /*
    与栏目同义的旧标签：文章已经不打这些标签了（见 README「分类与标签怎么分工」），
    页面不会再由文章生成。旧链接和搜索引擎里的地址还在，这里补跳转页跳到对应栏目，
    避免 404 —— 和 /music → /collection 的处理方式一致。

    注意：这段必须写在 getStaticPaths 内部。它会连同函数一起被抽出到独立模块里执行，
    引用不到 frontmatter 里的模块级常量。
  */
  const tagPages = tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });

  const retiredPages = Object.entries(RETIRED_TAGS).map(([tag, category]) => ({
    params: { tag },
    props: { redirectTo: categoryPath(category) },
  }));

  return [...tagPages, ...retiredPages];
}

const { page, tagName, redirectTo } = Astro.props as {
  page?: Page<CollectionEntry<"blog">>;
  tagName?: string;
  redirectTo?: string;
};

/* 退场标签：旧地址 301 到对应栏目 */
if (redirectTo) return Astro.redirect(redirectTo, 301);
/* 兜底：有标签就一定有分页数据，走不到这里 */
if (!page || !tagName) return Astro.redirect("/tags/", 302);
---

<TagPosts {page} {tagName} />
