---
/**
 * 收藏页的浮空播放窗。
 *
 * 数据由 `npm run sync:navidrome` 生成：每张专辑的曲目 id + 一份 stream 凭据。
 * 音频直接走 Navidrome 的 Subsonic `/rest/stream`（支持 Range，所以能拖进度），
 * 不经过本站。
 *
 * 播放控制全在这一个组件里；收藏页那边只需给按钮加 `data-album-open="<索引>"`。
 */
interface Track {
  id: string;
  title: string;
  track: number | null;
  duration: number | null;
}

interface AlbumPayload {
  id: string;
  name: string;
  artist: string;
  cover: string | null;
  tracks: Track[];
}

interface Props {
  serverUrl: string;
  stream: { user: string; token: string; salt: string; client: string };
  albums: AlbumPayload[];
}

const { serverUrl, stream, albums } = Astro.props;

// 没有曲目的专辑打不开播放窗，直接从载荷里剔掉（索引要和页面上的一致）
const playable = albums.filter(album => album.tracks.length > 0);
const payload = { serverUrl, stream, albums: playable };
---

<collection-player>
  <audio id="np-audio" preload="none"></audio>

  <div class="np" id="np" hidden>
    <div class="np-head">
      <img class="np-cover" id="np-cover" alt="" width="52" height="52" />
      <div class="np-meta">
        <p class="np-title" id="np-title"></p>
        <p class="np-artist" id="np-artist"></p>
        <p class="np-now" id="np-now"></p>
      </div>
      <a
        class="np-icon-btn"
        id="np-ext"
        target="_blank"
        rel="noopener noreferrer"
        title="在 Navidrome 打开"
        aria-label="在 Navidrome 打开"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17l9.2-9.2"></path>
          <path d="M17 17V7H7"></path>
        </svg>
      </a>
      <button
        class="np-icon-btn"
        id="np-close"
        type="button"
        title="关闭"
        aria-label="关闭播放器"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12"></path>
          <path d="M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <ol class="np-tracks" id="np-tracks"></ol>

    <p class="np-status" id="np-status" hidden></p>

    <div class="np-progress-row">
      <span class="np-time" id="np-cur">0:00</span>
      <div
        class="np-progress"
        id="np-progress"
        role="slider"
        tabindex="0"
        aria-label="播放进度"
        aria-valuemin="0"
        aria-valuemax="0"
        aria-valuenow="0"
      >
        <div class="np-fill" id="np-fill"></div>
      </div>
      <span class="np-time" id="np-dur">0:00</span>
    </div>

    <div class="np-ctrl">
      <button
        class="np-icon-btn"
        id="np-shuffle"
        type="button"
        title="随机播放（本专辑内）"
        aria-label="随机播放"
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M16 3h5v5"></path>
          <path d="M4 20L21 3"></path>
          <path d="M21 16v5h-5"></path>
          <path d="M15 15l6 6"></path>
          <path d="M4 4l5 5"></path>
        </svg>
      </button>
      <button
        class="np-icon-btn"
        id="np-prev"
        type="button"
        aria-label="上一首"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="fill-icon">
          <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"></path>
        </svg>
      </button>
      <button class="np-play" id="np-play" type="button" aria-label="播放">
        <svg viewBox="0 0 24 24" aria-hidden="true" id="np-icon-play">
          <path d="M7 5v14l12-7z"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          id="np-icon-pause"
          style="display:none"
        >
          <rect x="5" y="4" width="5" height="16" rx="1"></rect>
          <rect x="14" y="4" width="5" height="16" rx="1"></rect>
        </svg>
      </button>
      <button
        class="np-icon-btn"
        id="np-next"
        type="button"
        aria-label="下一首"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="fill-icon">
          <path d="M6 18l8.5-6L6 6v12zm10-12v12h2V6z"></path>
        </svg>
      </button>

      <div class="np-vol">
        <button
          class="np-icon-btn"
          id="np-mute"
          type="button"
          title="静音"
          aria-label="静音"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="fill-icon"
            id="np-vol-on"
          >
            <path
              d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0014 8.5v7a4.5 4.5 0 002.5-3.5zM14 4.5v2.1c2.9.9 5 3.5 5 6.4s-2.1 5.5-5 6.4v2.1c4-.9 7-4.5 7-8.5s-3-7.6-7-8.5z"
            ></path>
          </svg>
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="fill-icon"
            id="np-vol-mute"
            style="display:none"
          >
            <path d="M3 9v6h4l5 5V4L7 9H3zm13 3l4-4m0 4l-4-4"></path>
          </svg>
        </button>
        <input
          type="range"
          id="np-vol"
          class="np-vol-slider"
          min="0"
          max="100"
          value="80"
          aria-label="音量"
        />
      </div>
    </div>
  </div>

  <script
    type="application/json"
    id="np-data"
    set:html={JSON.stringify(payload)}
  />
</collection-player>

<!--
  必须用 is:global：曲目行是脚本用 innerHTML 生成的，
  拿不到 Astro 给模板元素打的 scope 类，scoped 样式既不会命中、还会被编译期裁剪掉。
-->
<style is:global>
  /* ── 浮空面板：桌面右下角，窄屏变底部抽屉 ── */
  .np {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 60;
    display: flex;
    flex-direction: column;
    width: min(23rem, calc(100vw - 2rem));
    max-height: min(70vh, 40rem);
    border: 1px solid rgb(var(--palette-border));
    border-radius: 1.125rem;
    background-color: rgb(var(--palette-fill));
    box-shadow: 0 22px 60px rgb(0 0 0 / 0.28);
    overflow: hidden;
  }
  .np[hidden] {
    display: none;
  }
  @media (max-width: 40rem) {
    .np {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      width: auto;
      max-height: 64vh;
    }
  }

  /* ── 头部：封面 + 专辑信息 + 外链 / 关闭 ── */
  .np-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 0.875rem 0.75rem;
    border-bottom: 1px solid rgb(var(--palette-border));
  }
  .np-cover {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.625rem;
    object-fit: cover;
    background-color: rgb(var(--palette-muted));
  }
  .np-meta {
    flex: 1;
    min-width: 0;
  }
  .np-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(var(--palette-text));
  }
  .np-artist {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(var(--palette-muted-text));
  }
  .np-now {
    margin: 0.125rem 0 0;
    font-size: 0.75rem;
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(var(--palette-accent));
  }
  .np-now:empty {
    display: none;
  }

  .np-icon-btn {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    border-radius: 0.5rem;
    background: none;
    color: rgb(var(--palette-muted-text));
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .np-icon-btn:hover {
    background-color: rgb(var(--palette-muted));
    color: rgb(var(--palette-text));
  }
  .np-icon-btn svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .np-icon-btn svg.fill-icon {
    fill: currentColor;
    stroke: none;
  }
  #np-icon-play,
  #np-icon-pause {
    width: 1.375rem;
    height: 1.375rem;
    fill: currentColor;
    stroke: none;
  }

  /* ── 曲目列表 ── */
  .np-tracks {
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 0.375rem;
    overflow-y: auto;
    list-style: none;
    overscroll-behavior: contain;
  }
  .np-track {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    padding: 0.5625rem 0.625rem;
    border: none;
    border-radius: 0.5rem;
    background: none;
    color: rgb(var(--palette-text));
    font-family: inherit;
    font-size: 0.875rem;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .np-track:hover {
    background-color: rgb(var(--palette-muted));
  }
  .np-track.is-current {
    color: rgb(var(--palette-accent));
    font-weight: 600;
  }
  .np-tnum {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    flex: none;
    width: 1.25rem;
    font-family: "IBM Plex Mono", "Consolas", monospace;
    font-size: 0.75rem;
    color: rgb(var(--palette-muted-text));
  }
  .np-track.is-current .np-tnum {
    color: rgb(var(--palette-accent));
  }
  /* 曲目之间的分隔线（之前 16% 太淡，看着像没有分隔） */
  .np-tracks li + li {
    border-top: 1px solid
      color-mix(in srgb, rgb(var(--palette-muted-text)) 30%, transparent);
  }
  /* 当前曲目：左侧主题色竖条 + 整行淡底 + 序号换成跳动的音浪条 */
  .np-track.is-current::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 3px;
    border-radius: 0 2px 2px 0;
    background-color: rgb(var(--palette-accent));
  }
  .np-track.is-current {
    background-color: color-mix(
      in srgb,
      rgb(var(--palette-accent)) 16%,
      transparent
    );
  }
  .np-track.is-current .np-tname {
    font-weight: 600;
  }
  .np-track.is-current .np-tdur {
    color: rgb(var(--palette-accent));
  }
  .np-track:hover .np-tnum {
    color: rgb(var(--palette-accent));
  }
  .np-eq {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 0.8125rem;
  }
  .np-track.is-current .np-eq {
    display: inline-flex;
  }
  .np-track.is-current .np-tnum-text {
    display: none;
  }
  .np-eq i {
    width: 3px;
    height: 35%;
    border-radius: 1px;
    background: currentColor;
    animation: np-eq 0.9s ease-in-out infinite;
  }
  .np-eq i:nth-child(2) {
    height: 100%;
    animation-delay: 0.15s;
  }
  .np-eq i:nth-child(3) {
    height: 62%;
    animation-delay: 0.3s;
  }
  .np:not(.is-playing) .np-eq i {
    animation-play-state: paused;
  }
  @keyframes np-eq {
    0%,
    100% {
      transform: scaleY(0.35);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .np-tname {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .np-tdur {
    flex: none;
    font-family: "IBM Plex Mono", "Consolas", monospace;
    font-size: 0.75rem;
    color: rgb(var(--palette-muted-text));
  }

  /* ── 进度 ── */
  /* 加载 / 缓冲 / 失败提示：大 FLAC 走 FRP 时首帧可能等几秒，
     没有这行字用户会以为"点了没反应" */
  .np-status {
    margin: 0;
    padding: 0.25rem 0.875rem 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: rgb(var(--palette-muted-text));
  }
  .np-status.is-error {
    color: #d14343;
  }
  .np-status[hidden] {
    display: none;
  }
  .np-progress-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem 0;
  }
  .np-time {
    flex: none;
    min-width: 2.25rem;
    font-family: "IBM Plex Mono", "Consolas", monospace;
    font-size: 0.6875rem;
    color: rgb(var(--palette-muted-text));
  }
  .np-time:last-child {
    text-align: right;
  }
  .np-progress {
    position: relative;
    flex: 1;
    height: 1rem;
    cursor: pointer;
    touch-action: none;
  }
  .np-progress::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 4px;
    border-radius: 999px;
    background-color: rgb(var(--palette-muted));
    transform: translateY(-50%);
  }
  .np-fill {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0;
    height: 4px;
    border-radius: 999px;
    background-color: rgb(var(--palette-accent));
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* ── 控制 ── */
  .np-ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem 0.875rem;
  }
  /* 随机按钮靠左、音量靠右，中间的上一首/播放/下一首保持居中 */
  #np-shuffle {
    margin-right: auto;
  }
  #np-shuffle[aria-pressed="true"] {
    color: rgb(var(--palette-accent));
    background-color: color-mix(
      in srgb,
      rgb(var(--palette-accent)) 14%,
      transparent
    );
  }
  .np-vol {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .np-vol-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 4.25rem;
    height: 4px;
    border-radius: 999px;
    background: rgb(var(--palette-muted));
    outline: none;
    cursor: pointer;
  }
  .np-vol-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgb(var(--palette-accent));
    cursor: pointer;
  }
  .np-vol-slider::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border: none;
    border-radius: 50%;
    background: rgb(var(--palette-accent));
    cursor: pointer;
  }
  .np-play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: rgb(var(--palette-accent));
    color: rgb(var(--palette-fill));
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.2s ease;
    box-shadow: 0 6px 18px
      color-mix(in srgb, rgb(var(--palette-accent)) 42%, transparent);
  }
  .np-play:hover {
    transform: scale(1.06);
  }
  .np-play:active {
    transform: scale(0.97);
  }
</style>

<script>
  interface Payload {
    serverUrl: string;
    stream: { user: string; token: string; salt: string; client: string };
    albums: {
      id: string;
      name: string;
      artist: string;
      cover: string | null;
      tracks: {
        id: string;
        title: string;
        track: number | null;
        duration: number | null;
      }[];
    }[];
  }

  const fmt = (seconds: number) => {
    if (!Number.isFinite(seconds) || seconds < 0) return "0:00";
    const total = Math.floor(seconds);
    const m = Math.floor(total / 60);
    const s = total % 60;
    return `${m}:${String(s).padStart(2, "0")}`;
  };

  function streamUrl(payload: Payload, songId: string) {
    const { serverUrl, stream } = payload;
    const query = new URLSearchParams({
      id: songId,
      u: stream.user,
      t: stream.token,
      s: stream.salt,
      v: "1.16.1",
      c: stream.client,
    });
    return `${serverUrl}/rest/stream?${query}`;
  }

  /*
    站内跳转会新建一份组件 DOM（和新的 <audio>），脚本通过 astro:page-load 再跑一次。
    如果每次都往 document 上挂一个点击监听，旧监听不会消失 —— 它会去操作旧实例那个
    **已经脱离 DOM 的 <audio>**，而浏览器允许脱离文档的音频继续播放，于是就会出现
    "两首歌同时播放"。所以文档级监听只注册一次，靠 activePlayer 转发给当前实例。
  */
  let activePlayer: { open: (index: number) => void } | null = null;
  let docClickBound = false;

  function initPlayer() {
    const host = document.querySelector<HTMLElement>("collection-player");
    const dataEl = document.getElementById("np-data");
    if (!host || !dataEl || host.dataset.ready === "true") return;
    host.dataset.ready = "true";

    const payload = JSON.parse(dataEl.textContent ?? "{}") as Payload;
    if (!payload.albums?.length) return;

    const panel = document.getElementById("np") as HTMLElement;
    const audio = document.getElementById("np-audio") as HTMLAudioElement;
    const cover = document.getElementById("np-cover") as HTMLImageElement;
    const titleEl = document.getElementById("np-title") as HTMLElement;
    const artistEl = document.getElementById("np-artist") as HTMLElement;
    const nowEl = document.getElementById("np-now") as HTMLElement;
    const statusEl = document.getElementById("np-status") as HTMLElement;
    const extLink = document.getElementById("np-ext") as HTMLAnchorElement;
    const listEl = document.getElementById("np-tracks") as HTMLElement;
    const fill = document.getElementById("np-fill") as HTMLElement;
    const progress = document.getElementById("np-progress") as HTMLElement;
    const curEl = document.getElementById("np-cur") as HTMLElement;
    const durEl = document.getElementById("np-dur") as HTMLElement;
    const playBtn = document.getElementById("np-play") as HTMLButtonElement;
    const iconPlay = document.getElementById("np-icon-play") as HTMLElement;
    const iconPause = document.getElementById("np-icon-pause") as HTMLElement;
    const shuffleBtn = document.getElementById(
      "np-shuffle"
    ) as HTMLButtonElement;
    const muteBtn = document.getElementById("np-mute") as HTMLButtonElement;
    const volSlider = document.getElementById("np-vol") as HTMLInputElement;
    const volOn = document.getElementById("np-vol-on") as HTMLElement;
    const volMute = document.getElementById("np-vol-mute") as HTMLElement;

    let albumIndex = -1;
    let trackIndex = -1;
    let playing = false;
    let seeking = false;
    /** 连续失败计数：整张专辑都放不了时不要无限跳 */
    let failedStreak = 0;
    /** 当前专辑的播放顺序（开随机时是打乱后的） */
    let queue: number[] = [];

    // 音量 / 随机开关记在本机，下次打开还是这个设置
    const readStored = <T,>(key: string, fallback: T): T => {
      try {
        const raw = localStorage.getItem(`np:${key}`);
        return raw === null ? fallback : (JSON.parse(raw) as T);
      } catch {
        return fallback;
      }
    };
    const writeStored = (key: string, value: unknown) => {
      try {
        localStorage.setItem(`np:${key}`, JSON.stringify(value));
      } catch {
        /* 隐私模式 / 禁用存储时忽略 */
      }
    };

    const setStatus = (text: string | null, isError = false) => {
      statusEl.textContent = text ?? "";
      statusEl.hidden = !text;
      statusEl.classList.toggle("is-error", Boolean(text) && isError);
    };

    let shuffle = readStored("shuffle", false);
    let lastVolume = readStored("volume", 80);
    shuffleBtn.setAttribute("aria-pressed", String(shuffle));

    const album = () => payload.albums[albumIndex];

    function syncIcon() {
      iconPlay.style.display = playing ? "none" : "";
      iconPause.style.display = playing ? "" : "none";
      playBtn.setAttribute("aria-label", playing ? "暂停" : "播放");
      // 面板上的 is-playing 用来控制音浪条动画
      panel.classList.toggle("is-playing", playing);
    }

    /** 按当前专辑重建播放顺序；开了随机就洗牌 */
    function buildQueue() {
      const current = album();
      const order = current ? current.tracks.map((_, index) => index) : [];
      if (shuffle) {
        for (let i = order.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          [order[i], order[j]] = [order[j], order[i]];
        }
      }
      queue = order;
    }

    /** 队列里往前走/往后走一步（不循环出专辑） */
    function step(delta: number) {
      const current = album();
      if (!current) return;
      if (queue.length !== current.tracks.length) buildQueue();
      const at = queue.indexOf(trackIndex);
      const next = at < 0 ? 0 : (at + delta + queue.length) % queue.length;
      playTrack(queue[next]);
    }

    function renderTracks() {
      const current = album();
      if (!current) return;
      listEl.innerHTML = current.tracks
        .map(
          (item, index) => `
          <li>
            <button type="button" class="np-track${index === trackIndex ? " is-current" : ""}" data-track="${index}">
              <span class="np-tnum">
                <span class="np-tnum-text">${String(item.track ?? index + 1).padStart(2, "0")}</span>
                <span class="np-eq" aria-hidden="true"><i></i><i></i><i></i></span>
              </span>
              <span class="np-tname"></span>
              <span class="np-tdur">${item.duration ? fmt(item.duration) : ""}</span>
            </button>
          </li>`
        )
        .join("");
      // 曲名用 textContent 写，避免歌名里的特殊字符被当成 HTML
      listEl.querySelectorAll<HTMLElement>(".np-tname").forEach((el, index) => {
        el.textContent = current.tracks[index].title;
      });
    }

    function highlight() {
      listEl
        .querySelectorAll<HTMLElement>(".np-track")
        .forEach((el, index) =>
          el.classList.toggle("is-current", index === trackIndex)
        );
    }

    function playTrack(index: number) {
      const current = album();
      if (!current || !current.tracks[index]) return;
      trackIndex = index;
      highlight();
      const item = current.tracks[index];
      nowEl.textContent = item.title;
      setStatus("加载中…");
      audio.src = streamUrl(payload, item.id);
      durEl.textContent = item.duration ? fmt(item.duration) : "0:00";
      audio.play().catch(() => {
        playing = false;
        syncIcon();
        setStatus("浏览器拦截了自动播放，点播放键开始");
      });
    }

    function openAlbum(index: number) {
      const current = payload.albums[index];
      if (!current) return;
      albumIndex = index;
      trackIndex = -1;
      nowEl.textContent = "";
      setStatus(null);
      titleEl.textContent = current.name;
      artistEl.textContent = current.artist;
      cover.src = current.cover ?? "";
      cover.alt = current.name;
      if (payload.serverUrl) {
        extLink.href = `${payload.serverUrl}/app/#/album/${current.id}/show`;
        extLink.hidden = false;
      } else {
        extLink.hidden = true;
      }
      renderTracks();
      panel.hidden = false;
      buildQueue();
      // 点击专辑本身就是用户手势，可以直接开始；开了随机就随机选一首起头
      playTrack(shuffle ? (queue[0] ?? 0) : 0);
    }

    function close() {
      audio.pause();
      panel.hidden = true;
      setStatus(null);
    }

    // 页面上的专辑按钮 → 打开播放窗（只认当前这一份实例）
    activePlayer = { open: openAlbum };
    if (!docClickBound) {
      docClickBound = true;
      document.addEventListener("click", event => {
        const trigger = (event.target as HTMLElement).closest<HTMLElement>(
          "[data-album-open]"
        );
        if (!trigger) return;
        event.preventDefault();
        activePlayer?.open(Number(trigger.dataset.albumOpen));
      });
    }

    listEl.addEventListener("click", event => {
      const button = (event.target as HTMLElement).closest<HTMLElement>(
        "[data-track]"
      );
      if (!button) return;
      const index = Number(button.dataset.track);
      if (index === trackIndex && playing) {
        audio.pause();
        return;
      }
      playTrack(index);
    });

    playBtn.addEventListener("click", () => {
      if (trackIndex < 0) {
        playTrack(0);
        return;
      }
      if (playing) audio.pause();
      else audio.play().catch(() => {});
    });

    document
      .getElementById("np-prev")
      ?.addEventListener("click", () => step(-1));
    document
      .getElementById("np-next")
      ?.addEventListener("click", () => step(1));
    document.getElementById("np-close")?.addEventListener("click", close);

    // 随机播放（只在当前专辑内洗牌）
    shuffleBtn.addEventListener("click", () => {
      shuffle = !shuffle;
      shuffleBtn.setAttribute("aria-pressed", String(shuffle));
      writeStored("shuffle", shuffle);
      buildQueue();
      // 洗牌后把当前这首放到队首，避免刚点开就被换歌
      if (trackIndex >= 0) {
        queue = [trackIndex, ...queue.filter(index => index !== trackIndex)];
      }
    });

    // 音量 + 静音
    const applyVolume = () => {
      const value = Number(volSlider.value);
      audio.volume = value / 100;
      const silent = value === 0;
      volOn.style.display = silent ? "none" : "";
      volMute.style.display = silent ? "" : "none";
      muteBtn.setAttribute("aria-label", silent ? "取消静音" : "静音");
    };
    volSlider.value = String(lastVolume);
    applyVolume();
    volSlider.addEventListener("input", () => {
      lastVolume = Number(volSlider.value);
      applyVolume();
      writeStored("volume", lastVolume);
    });
    muteBtn.addEventListener("click", () => {
      if (Number(volSlider.value) > 0) {
        lastVolume = Number(volSlider.value);
        volSlider.value = "0";
      } else {
        volSlider.value = String(lastVolume || 80);
      }
      applyVolume();
      writeStored("volume", Number(volSlider.value));
    });

    audio.addEventListener("play", () => {
      playing = true;
      syncIcon();
    });
    // 开始出声 / 有足够数据可播时，清掉提示
    audio.addEventListener("playing", () => {
      failedStreak = 0;
      setStatus(null);
    });
    audio.addEventListener("canplay", () => {
      failedStreak = 0;
      setStatus(null);
    });
    audio.addEventListener("waiting", () => {
      setStatus("缓冲中…");
    });
    /*
      播放失败（网络、格式、文件损坏等）——之前这里什么都不做，
      点了没反应也看不出原因。现在会给出原因并自动跳下一首。
    */
    audio.addEventListener("error", () => {
      failedStreak += 1;
      const current = album();
      const detail = audio.error ? `（code ${audio.error.code}）` : "";
      if (!current || current.tracks.length <= 1 || failedStreak >= 3) {
        setStatus(`这首播放失败${detail}`, true);
        return;
      }
      setStatus(`这首播放失败${detail}，正在跳到下一首…`, true);
      window.setTimeout(() => {
        if (host.isConnected && failedStreak < 3) step(1);
      }, 900);
    });
    audio.addEventListener("pause", () => {
      playing = false;
      syncIcon();
    });
    audio.addEventListener("ended", () => {
      step(1);
    });
    audio.addEventListener("timeupdate", () => {
      if (seeking || !audio.duration) return;
      fill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
      curEl.textContent = fmt(audio.currentTime);
    });
    audio.addEventListener("loadedmetadata", () => {
      durEl.textContent = fmt(audio.duration);
      progress.setAttribute("aria-valuemax", String(audio.duration));
    });

    // 拖动进度条
    const seekTo = (clientX: number) => {
      const rect = progress.getBoundingClientRect();
      const ratio = Math.min(
        1,
        Math.max(0, (clientX - rect.left) / rect.width)
      );
      if (audio.duration) {
        audio.currentTime = ratio * audio.duration;
        fill.style.width = `${ratio * 100}%`;
        curEl.textContent = fmt(ratio * audio.duration);
      }
    };
    progress.addEventListener("pointerdown", event => {
      seeking = true;
      progress.setPointerCapture(event.pointerId);
      seekTo(event.clientX);
    });
    progress.addEventListener("pointermove", event => {
      if (seeking) seekTo(event.clientX);
    });
    const endSeek = () => {
      seeking = false;
    };
    progress.addEventListener("pointerup", endSeek);
    progress.addEventListener("pointercancel", endSeek);

    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && !panel.hidden) close();
    });

    /*
      离开页面时停止播放：站内跳转走 astro:before-swap，整页跳转走 pagehide。
      和之前播放器踩过的坑一样 —— 视图切换只换 DOM，闭包里的 <audio> 会继续出声。
    */
    const release = () => {
      audio.pause();
      audio.removeAttribute("src");
      audio.load();
      playing = false;
      syncIcon();
    };
    document.addEventListener("astro:before-swap", release, { once: true });
    window.addEventListener("pagehide", release, { once: true });

    /*
      双保险：旧组件被移出文档时立刻收尾（并让 activePlayer 不再指向它）。
      即使哪天 astro:before-swap 没跑到，脱离 DOM 的 <audio> 也不会继续出声。
    */
    if (!customElements.get("collection-player")) {
      customElements.define(
        "collection-player",
        class extends HTMLElement {
          disconnectedCallback() {
            (
              this as HTMLElement & { __npRelease?: () => void }
            ).__npRelease?.();
          }
        }
      );
    }
    (host as HTMLElement & { __npRelease?: () => void }).__npRelease = () => {
      release();
      if (activePlayer?.open === openAlbum) activePlayer = null;
    };
  }

  initPlayer();
  document.addEventListener("astro:page-load", initPlayer);
</script>
