---
/**
 * 极简内联图标集（tabler 风格的线性图标）。
 *
 * 只收录站点自己用得到的图标，避免为了几个图标引入整个图标库。
 * 图标继承 currentColor，尺寸默认 1em，可通过 class/size 覆盖。
 */
export type IconName =
  | "calendar"
  | "clock"
  | "hashtag"
  | "copy"
  | "check"
  | "book"
  | "archive"
  | "search"
  | "headphones"
  | "link"
  | "user"
  | "tv"
  | "clipboard"
  | "qrcode"
  | "share"
  | "copyright"
  | "map-pin"
  | "tool"
  | "heart"
  | "school";

interface Props {
  name: IconName;
  /** 图标边长（px），默认 16 */
  size?: number;
  class?: string;
}

const { name, size = 16, class: className = "" } = Astro.props;

