---
import type { MarkdownHeading } from "astro";

/**
 * 右侧粘性目录：每一项左侧有一条进度条，随阅读位置填充；
 * 当前所在小节高亮，点标题平滑跳转并写入 URL hash。
 *
 * 目录项来自 Astro render() 返回的 headings，因此文章里不用手写
 * `Table of contents` 段落。
 */
interface Props {
  headings: MarkdownHeading[];
  /** 少于这么多条目录时整个组件不渲染 */
  minItems?: number;
}

const { headings, minItems = 2 } = Astro.props;

const toc = headings.filter(h => h.depth >= 2 && h.depth <= 3);
const show = toc.length >= minItems;

/*
  目录配色：色相按「节」分配，每开一节色相往前推 60°（彩虹顺序循环）。

  哪一级算"一节"：目录里最浅的那一级。文章用 ## 分节时，一个二级标题开一节，
  它下面的三级标题沿用同一色相、只是去饱和压淡；有的文章通篇只有 ###（没有二级），
  那每个三级标题自己就是一节，颜色照样一节一换，不会整列一个色。

  于是侧栏里两件事都能一眼看出来：文章分成几节（颜色在换），
  哪几项属于同一节（同色相 + 缩进）。
  起手取主题蓝的色相（202），往下正好落在蓝 → 紫 → 品红 → 橙 → 黄绿 → 青这一圈上。
*/
const HUE_START = 202;
const HUE_STEP = 60;

/** 目录里最浅的一级（通常是 2）；空目录时给个兜底值 */
const topDepth = toc.length ? Math.min(...toc.map(h => h.depth)) : 2;

let sectionIndex = -1;
const tocItems = toc.map(heading => {
  if (heading.depth === topDepth) sectionIndex += 1;
  return {
    ...heading,
    hue: (HUE_START + sectionIndex * HUE_STEP) % 360,
    /** 比最浅一级更深的项才是"子项"（缩进 + 浅色） */
    isSub: heading.depth > topDepth,
  };
});
---

{
  show && (
    <toc-nav class="toc">
      <p class="toc-title">目录</p>
      <ul class="toc-list">
        {tocItems.map(heading => (
          <li
            class:list={["toc-item", heading.isSub && "toc-item-sub"]}
            style={`--toc-hue:${heading.hue}`}
          >
            <span class="toc-bar" aria-hidden="true">
              <span class="toc-bar-fill" />
            </span>
            <a
              class="toc-link"
              href={`#${heading.slug}`}
              data-slug={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </toc-nav>
  )
}

<style>
  @reference "../styles/base.css";

  .toc {
    display: block;
  }
  .toc-title {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    @apply text-foreground;
  }
  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc-item {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    /*
      每个目录项带一个色相（由组件按"节"写进 --toc-hue）：
      节标题是本节主色，子项是同色相去饱和的次级色；
      左侧色条与阅读进度用同一个色相。
      颜色都用 hsl() 直接写，不用 color-mix —— 免得旧浏览器把整条声明判成无效值。
    */
    --toc-color: hsl(var(--toc-hue) 62% 40%);
    --toc-color-sub: hsl(var(--toc-hue) 34% 46%);
    --toc-rail: hsl(var(--toc-hue) 55% 55% / 0.55);
    --toc-rail-sub: hsl(var(--toc-hue) 45% 55% / 0.32);
    --toc-active-bg: hsl(var(--toc-hue) 65% 50% / 0.12);
  }
  :global(html[data-theme="dark"]) .toc-item {
    --toc-color: hsl(var(--toc-hue) 76% 72%);
    --toc-color-sub: hsl(var(--toc-hue) 40% 70%);
    --toc-rail: hsl(var(--toc-hue) 60% 60% / 0.5);
    --toc-rail-sub: hsl(var(--toc-hue) 50% 60% / 0.3);
    --toc-active-bg: hsl(var(--toc-hue) 60% 58% / 0.16);
  }
  .toc-bar {
    position: relative;
    flex: none;
    width: 2px;
    border-radius: 999px;
    background-color: var(--toc-rail);
    overflow: hidden;
  }
  .toc-bar-fill {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 0;
    background-color: var(--toc-color);
    transition: height 0.15s linear;
  }
  .toc-link {
    flex: 1;
    min-width: 0;
    padding: 0.1875rem 0.375rem;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--toc-color);
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  /* 开一节的那一项比它的子项重一档 —— 颜色之外再加一层"这是分节标题"的提示 */
  .toc-item:not(.toc-item-sub) .toc-link {
    font-weight: 500;
  }
  .toc-item .toc-link:hover {
    @apply text-foreground;
    background-color: color-mix(
      in srgb,
      rgb(var(--palette-muted)) 70%,
      transparent
    );
  }
  .toc-item .toc-link.is-active {
    color: var(--toc-color);
    font-weight: 600;
    background-color: var(--toc-active-bg);
  }
  .toc-item-sub .toc-link {
    padding-inline-start: 1rem;
    font-size: 0.78125rem;
    font-weight: 400;
    color: var(--toc-color-sub);
  }
  .toc-item-sub .toc-bar {
    background-color: var(--toc-rail-sub);
  }
  .toc-item-sub .toc-bar-fill {
    background-color: var(--toc-color-sub);
  }
</style>

<script>
  type TocItem = {
    link: HTMLAnchorElement;
    fill: HTMLElement | null;
    heading: HTMLElement;
  };

  /**
   * 阅读位置按「探针线」计算：探针在视口上方 28% 处，
   * 它落在哪个小节的区间里，哪个小节就是当前小节；
   * 区间内的推进比例就是这一项的进度条高度。
   */
  const PROBE_RATIO = 0.28;

  function setupToc(nav: HTMLElement) {
    // 视图切换会重新插入同一个组件，用标记位避免重复绑定
    if (nav.dataset.tocReady === "true") return;
    nav.dataset.tocReady = "true";

    const items: TocItem[] = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>(".toc-link")
    )
      .map(link => {
        const slug = link.dataset.slug;
        const heading = slug ? document.getElementById(slug) : null;
        return {
          link,
          fill:
            link.parentElement?.querySelector<HTMLElement>(".toc-bar-fill") ??
            null,
          heading: heading as HTMLElement,
        };
      })
      .filter(item => item.heading instanceof HTMLElement);

    if (!items.length) return;

    const article = document.getElementById("article");
    let frame = 0;

    const update = () => {
      frame = 0;
      // 页面切换后旧节点会脱离文档，直接停更
      if (!nav.isConnected) return;

      const probe = window.scrollY + window.innerHeight * PROBE_RATIO;
      const articleEnd =
        (article?.getBoundingClientRect().bottom ?? 0) + window.scrollY;

      let activeIndex = -1;

      items.forEach((item, index) => {
        const start = item.heading.getBoundingClientRect().top + window.scrollY;
        const end =
          index + 1 < items.length
            ? items[index + 1].heading.getBoundingClientRect().top +
              window.scrollY
            : Math.max(articleEnd, start + 1);
        const span = Math.max(end - start, 1);
        const progress = Math.min(1, Math.max(0, (probe - start) / span));

        if (item.fill) {
          item.fill.style.height = `${(progress * 100).toFixed(1)}%`;
        }
        if (probe >= start) activeIndex = index;
      });

      items.forEach((item, index) => {
        item.link.classList.toggle("is-active", index === activeIndex);
      });
    };

    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(update);
    };

    nav.addEventListener("click", event => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>(
        ".toc-link"
      );
      if (!link) return;

      const slug = link.dataset.slug;
      const heading = slug ? document.getElementById(slug) : null;
      if (!slug || !heading) return;

      /*
        这里不要自己 pushState：手工写入 null 会把 Astro 视图过渡存在
        history.state 里的 { index, scrollX, scrollY } 抹掉，之后按返回键就会出现
        「地址回到上一页、页面却还停在原地」。
        页内锚点交给浏览器与视图过渡自己处理（router.js 会先保存、再恢复 history.state），
        这里只负责平滑滚动与目录高亮。
      */
      heading.scrollIntoView({ behavior: "smooth", block: "start" });
      update();
    });

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();
  }

  function initTocs() {
    document.querySelectorAll<HTMLElement>("toc-nav").forEach(setupToc);
  }

  initTocs();
  document.addEventListener("astro:page-load", initTocs);
</script>
