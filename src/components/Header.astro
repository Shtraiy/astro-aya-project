---
import { LOGO_IMAGE, SITE } from "@config";
import Icon from "./Icon.astro";

export interface Props {
  activeNav?: "posts" | "tags" | "links" | "about" | "search" | "anime";
}

const { activeNav } = Astro.props;
const links = [
  { id: "posts", label: "文章" },
  { id: "tags", label: "标签" },
  { id: "anime", label: "追番" },
  { id: "links", label: "友链" },
  { id: "about", label: "关于我" },
];
---

<header class="site-header">
  <a class="skip-link" href="#main-content">跳到正文</a>

  <div class="header-inner">
    <a
      href="/"
      class="brand"
      aria-current={Astro.url.pathname === "/" ? "page" : undefined}
    >
      {
        LOGO_IMAGE.enable ? (
          <img
            src={`/assets/${LOGO_IMAGE.svg ? "logo.svg" : "logo.png"}`}
            alt={SITE.title}
            width={LOGO_IMAGE.width}
            height={LOGO_IMAGE.height}
          />
        ) : (
          <>
            <span class="brand-bird" aria-hidden="true" />
            <span>{SITE.title}</span>
          </>
        )
      }
    </a>

    <nav id="site-nav" class="site-nav" aria-label="主导航">
      <ul>
        {
          links.map(({ id, label }) => (
            <li>
              <a
                href={`/${id}/`}
                aria-current={activeNav === id ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-tools">
      <a
        class="tool"
        href="/search/"
        aria-label="搜索"
        title="搜索"
        aria-current={activeNav === "search" ? "page" : undefined}
      >
        <Icon name="search" size={21} />
      </a>
      {
        SITE.lightAndDarkMode && (
          <button
            id="theme-btn"
            type="button"
            class="tool"
            title="切换到深色主题"
            aria-label="深色模式"
            aria-pressed="false"
          >
            <svg id="moon-svg" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 13.06A9 9 0 1 1 10.94 3 7 7 0 0 0 21 13.06Z" />
            </svg>
            <svg id="sun-svg" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
            </svg>
          </button>
        )
      }
      <button
        type="button"
        class="tool menu-toggle"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path class="menu-open-icon" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="menu-close-icon" d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  @reference "../styles/base.css";

  .site-header {
    border-bottom: 2px solid var(--pixel-line);
    background-color: var(--pixel-surface);
  }

  .header-inner {
    @apply mx-auto grid w-full items-center px-4;
    max-width: var(--site-width);
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "brand tools" "nav nav";
    min-height: 3.5rem;
  }

  .skip-link {
    @apply bg-primary text-primary-foreground absolute top-3 left-4 z-50 -translate-y-[150%] px-3 py-2 focus:translate-y-0;
  }

  .brand {
    grid-area: brand;
    justify-self: start;
    @apply flex max-w-full items-center gap-1.5 whitespace-nowrap;
    font-family: var(--pixel-font);
    font-size: clamp(1.15rem, 3vw, 1.55rem);
    font-weight: 500;
  }

  .brand img {
    height: auto;
  }

  .brand-bird {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    background-color: rgb(var(--palette-accent));
    clip-path: polygon(
      0 15px,
      6px 15px,
      6px 12px,
      12px 12px,
      12px 6px,
      15px 6px,
      15px 3px,
      24px 3px,
      24px 6px,
      27px 6px,
      27px 9px,
      30px 9px,
      30px 12px,
      24px 12px,
      24px 21px,
      21px 21px,
      21px 24px,
      18px 24px,
      18px 27px,
      15px 27px,
      15px 24px,
      12px 24px,
      12px 27px,
      9px 27px,
      9px 24px,
      6px 24px,
      6px 21px,
      3px 21px,
      3px 18px,
      0 18px
    );
  }

  .brand-bird::after {
    position: absolute;
    inset: 6px auto auto 21px;
    width: 3px;
    height: 3px;
    background-color: var(--pixel-surface);
    content: "";
  }

  .site-nav {
    grid-area: nav;
    @apply border-t py-2;
    border-color: var(--pixel-line);
  }

  .site-nav ul {
    @apply flex flex-wrap gap-x-3;
  }

  .site-nav a {
    @apply pixel-ui-text text-muted-foreground flex min-h-10 items-center px-2 text-[0.9375rem] whitespace-nowrap;
  }

  .site-nav a:hover,
  .site-nav a[aria-current] {
    @apply text-primary;
    background-color: var(--pixel-selected);
    box-shadow: inset 0 -3px 0 currentColor;
  }

  .header-tools {
    grid-area: tools;
    @apply flex items-center;
  }

  .tool {
    @apply focus-outline text-foreground grid place-items-center;
    width: 44px;
    height: 44px;
  }

  .tool:hover,
  .tool[aria-current],
  .menu-toggle[aria-expanded="true"] {
    @apply text-primary;
    background-color: var(--pixel-selected);
    box-shadow: inset 0 -3px 0 currentColor;
  }

  .tool svg {
    @apply size-5 fill-none stroke-current;
    stroke-width: 1.65;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .menu-close-icon,
  .menu-toggle[aria-expanded="true"] .menu-open-icon {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .menu-close-icon {
    display: inline;
  }

  @media (max-width: 759px) {
    .header-inner:has(.menu-toggle[aria-expanded="false"]) .site-nav {
      display: none;
    }
  }

  @media (min-width: 760px) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: "brand nav tools";
      column-gap: 1.25rem;
      min-height: 4rem;
    }

    .site-nav {
      @apply border-0 p-0;
    }

    .site-nav ul {
      flex-wrap: nowrap;
    }

    .menu-toggle {
      display: none;
    }
  }
</style>

<script>
  function setMenuState(button: HTMLButtonElement, open: boolean) {
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
  }

  document.addEventListener("click", event => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>(".menu-toggle");
    if (!button) return;

    const open = button.getAttribute("aria-expanded") !== "true";
    setMenuState(button, open);
    if (open && event.detail === 0) {
      document.querySelector<HTMLElement>("#site-nav a")?.focus();
    }
  });

  document.addEventListener("keydown", event => {
    if (event.key !== "Escape") return;
    const button = document.querySelector<HTMLButtonElement>(
      '.menu-toggle[aria-expanded="true"]'
    );
    if (!button || button.offsetWidth === 0) return;
    setMenuState(button, false);
    button.focus();
  });
</script>
