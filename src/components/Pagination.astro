---
import type { Page } from "astro";
import LinkButton from "./LinkButton.astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="pagination-wrapper" aria-label="分页">
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        className={`mr-4 inline-flex items-center gap-1 select-none ${page.url.prev ? "" : "disabled"}`}
        ariaLabel="上一页"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          class="h-5 w-5"
          class:list={[{ "disabled-svg": !page.url.prev }]}
        >
          <path d="M12.707 17.293 8.414 13H18v-2H8.414l4.293-4.293-1.414-1.414L4.586 12l6.707 6.707z" />
        </svg>
        上一篇
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        className={`mx-4 inline-flex items-center gap-1 select-none ${page.url.next ? "" : "disabled"}`}
        ariaLabel="下一页"
      >
        下一篇
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          class="h-5 w-5"
          class:list={[{ "disabled-svg": !page.url.next }]}
        >
          <path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z" />
        </svg>
      </LinkButton>
    </nav>
  )
}

<style>
  @reference "../styles/base.css";
  .pagination-wrapper {
    @apply mt-auto mb-8 flex justify-center;
  }
  .disabled {
    @apply hover:text-skin-base group-hover:fill-skin-base pointer-events-none opacity-50 select-none;
  }
  .disabled-svg {
    @apply group-hover:!fill-skin-base;
  }
</style>
