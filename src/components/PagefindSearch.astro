---
import "@pagefind/default-ui/css/ui.css";

/*
  站内搜索：Pagefind。

  为什么不再用 Fuse：以前那份索引只装了标题和摘要，正文搜不到；中文又没有分词，
  把正文塞进 Fuse 只会得到一堆匹配不上的超长 token。Pagefind 在构建后扫一遍 HTML，
  生成带中文分词的静态索引（不占页面体积），搜索结果还能带上下文片段。

  索引是构建产物，所以本地开发默认搜不了：
  - 看构建结果：npm run build 之后 npm run preview
  - 想在 dev 里搜：npm run build && npm run search:index:dev（把索引也写进 public/）
*/
---

<div class="search-shell" data-search-root>
  <div id="search"></div>
  <p class="search-note" data-search-note hidden>
    搜索索引在构建时生成，本地开发默认没有。想看搜索效果：
    <code>npm run build &amp;&amp; npm run preview</code>；想在 dev 里直接搜：
    <code>npm run build &amp;&amp; npm run search:index:dev</code>。
  </p>
</div>

<style is:global>
  /*
    Pagefind 的类名不带 Astro 作用域，主题变量只能写在全局样式里。
    这里把它的调色板接到站点令牌上，深浅色自动跟随。
  */
  .search-shell {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: rgb(var(--palette-accent));
    --pagefind-ui-text: rgb(var(--palette-text));
    --pagefind-ui-background: rgb(var(--palette-fill));
    --pagefind-ui-border: rgb(var(--palette-border));
    --pagefind-ui-tag: rgb(var(--palette-muted));
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-font: var(--font-sans);
  }
  /* 输入框：跟站点输入框一致的描边与内边距 */
  .search-shell .pagefind-ui__search-input {
    border-color: rgb(var(--palette-border));
    background-color: rgb(var(--palette-fill));
    color: rgb(var(--palette-text));
  }
  .search-shell .pagefind-ui__search-input:focus {
    border-color: color-mix(
      in srgb,
      rgb(var(--palette-accent)) 55%,
      transparent
    );
  }
  /* 结果标题用强调色，正文摘要次级处理 */
  .search-shell .pagefind-ui__result-link {
    color: rgb(var(--palette-accent));
  }
  .search-shell .pagefind-ui__result-excerpt {
    color: rgb(var(--palette-muted-text));
  }
  /*
    命中的词：原来是一块 22% 强调色的底色，连着后面的空格一起变成一个方块，
    在深色主题下很像贴了张膏药。改成"强调色 + 细下划线"，一样能一眼扫到。
  */
  .search-shell .pagefind-ui mark {
    padding: 0;
    background: none;
    color: rgb(var(--palette-accent));
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: color-mix(
      in srgb,
      rgb(var(--palette-accent)) 45%,
      transparent
    );
    text-underline-offset: 3px;
  }

  /*
    结果列表：Pagefind 默认给每条结果 30/40px 的上下内边距 + 21px 的粗标题 + 整宽描边，
    一屏只装得下三四条，看着很臃肿。这里收成一条条紧凑的列表项：标题降到 1rem、
    摘要 0.8125rem 并截两行，去掉描边，改用悬停底色表示"这是一条可点的结果"。

    选择器写得长是有原因的：Pagefind 的默认样式挂着两个 Svelte 作用域类
    （`.pagefind-ui__result.svelte-xxx.svelte-xxx`，特异性 0,3,0），
    层级不够的写法压不住它。
  */
  .search-shell .pagefind-ui .pagefind-ui__results .pagefind-ui__result {
    gap: 0;
    padding: 0.5rem 0.75rem 0.625rem;
    border-top: 0;
    border-bottom: 0;
    border-radius: 0.75rem;
    transition: background-color 0.15s ease;
  }
  .search-shell .pagefind-ui .pagefind-ui__results .pagefind-ui__result:hover {
    background-color: color-mix(
      in srgb,
      rgb(var(--palette-muted)) 65%,
      transparent
    );
  }
  .search-shell .pagefind-ui .pagefind-ui__results .pagefind-ui__result-inner {
    margin-top: 0;
    gap: 0.125rem;
  }
  .search-shell
    .pagefind-ui
    .pagefind-ui__results
    .pagefind-ui__result
    .pagefind-ui__result-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .search-shell
    .pagefind-ui
    .pagefind-ui__results
    .pagefind-ui__result
    .pagefind-ui__result-title
    .pagefind-ui__result-link {
    color: rgb(var(--palette-text));
  }
  .search-shell
    .pagefind-ui
    .pagefind-ui__results
    .pagefind-ui__result
    .pagefind-ui__result-title
    .pagefind-ui__result-link:hover {
    color: rgb(var(--palette-accent));
    text-decoration: none;
  }
  /* 摘要：最多两行，长摘要不把列表撑开 */
  .search-shell
    .pagefind-ui
    .pagefind-ui__results
    .pagefind-ui__result
    .pagefind-ui__result-excerpt {
    display: -webkit-box;
    min-width: 0;
    overflow: hidden;
    font-size: 0.8125rem;
    line-height: 1.7;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  /* 一条结果里的多个命中位置（小标题）再降一级，只做引路的线索 */
  .search-shell
    .pagefind-ui
    .pagefind-ui__results
    .pagefind-ui__result
    .pagefind-ui__result-nested {
    gap: 0;
    padding-left: 0.75rem;
  }
  .search-shell
    .pagefind-ui
    .pagefind-ui__results
    .pagefind-ui__result
    .pagefind-ui__result-nested:first-of-type {
    padding-top: 0.25rem;
  }
  .search-shell
    .pagefind-ui
    .pagefind-ui__results
    .pagefind-ui__result
    .pagefind-ui__result-nested
    .pagefind-ui__result-title {
    font-size: 0.875rem;
    font-weight: 500;
  }
  .search-shell
    .pagefind-ui
    .pagefind-ui__results
    .pagefind-ui__result
    .pagefind-ui__result-nested
    .pagefind-ui__result-link {
    color: rgb(var(--palette-muted-text));
  }
  .search-shell
    .pagefind-ui
    .pagefind-ui__results
    .pagefind-ui__result
    .pagefind-ui__result-nested
    .pagefind-ui__result-link:hover {
    color: rgb(var(--palette-accent));
    text-decoration: none;
  }
  /* 「共 N 条结果」这行：跟着列表一起收紧 */
  .search-shell .pagefind-ui .pagefind-ui__message {
    height: auto;
    padding: 0 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(var(--palette-text));
  }
  /* 「加载更多结果」跟着站内的胶囊按钮走 */
  .search-shell .pagefind-ui .pagefind-ui__button {
    height: 2.5rem;
    margin-top: 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  /* 栏目筛选块底部那条 2px 的强调色描边太抢眼，压成一根细线 */
  .search-shell .pagefind-ui .pagefind-ui__filter-block {
    border-bottom-width: 1px;
  }
  /* 窄屏下筛选栏和结果区是上下堆叠的，60px 的间距会白掉半屏 */
  @media (max-width: 40rem) {
    .search-shell .pagefind-ui .pagefind-ui__drawer {
      gap: 1.25rem;
    }
  }
  .search-note {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.8;
    color: rgb(var(--palette-muted-text));
  }
  .search-note code {
    padding: 0.1rem 0.35rem;
    border-radius: 0.375rem;
    background-color: color-mix(
      in srgb,
      rgb(var(--palette-muted)) 75%,
      transparent
    );
    font-size: 0.8125rem;
  }
</style>

<script>
  import { PagefindUI } from "@pagefind/default-ui";

  /*
    索引缺失时（本地开发最常见）不初始化 UI，只显示提示，
    避免在页面上留一个"搜了没反应"的输入框。
  */
  let initialized = false;

  async function initSearch() {
    const root = document.querySelector<HTMLElement>("[data-search-root]");
    if (!root || initialized) return;

    const container = root.querySelector<HTMLElement>("#search");
    const note = root.querySelector<HTMLElement>("[data-search-note]");
    if (!container || container.childElementCount > 0) return;

    /* 用 entry json 探活：比运行时小得多，而且 GET 在所有静态托管上都可靠 */
    const hasIndex = await fetch("/pagefind/pagefind-entry.json")
      .then(response => response.ok)
      .catch(() => false);

    if (!hasIndex) {
      container.hidden = true;
      if (note) note.hidden = false;
      return;
    }

    initialized = true;
    const ui = new PagefindUI({
      element: "#search",
      showImages: false,
      showSubResults: true,
      translations: {
        placeholder: "搜索文章…",
        clear_search: "清空",
        load_more: "加载更多结果",
        search_label: "站内搜索",
        filters_label: "筛选",
        zero_results: "没有找到与「[SEARCH_TERM]」相关的内容",
        many_results: "「[SEARCH_TERM]」共 [COUNT] 条结果",
        one_result: "「[SEARCH_TERM]」1 条结果",
        alt_search: "没有「[SEARCH_TERM]」，改为显示「[DIFFERENT_TERM]」的结果",
        search_suggestion: "没有「[SEARCH_TERM]」，换个词试试：",
        searching: "正在搜索「[SEARCH_TERM]」…",
      },
    });

    /*
      关键词同步进 URL（?q=），搜索结果就能分享、刷新后也还在。
      replaceState 必须把 history.state 原样传回去 —— Astro 的视图过渡把自己的
      { index, scrollX, scrollY } 存在里面，用 null 覆盖会让返回键失灵。
    */
    const syncUrl = (term: string) => {
      const url = new URL(window.location.href);
      if (term) url.searchParams.set("q", term);
      else url.searchParams.delete("q");
      window.history.replaceState(window.history.state, "", url);
    };

    const input = root.querySelector<HTMLInputElement>(
      ".pagefind-ui__search-input"
    );
    if (input) {
      let syncTimer: ReturnType<typeof setTimeout> | undefined;
      input.addEventListener("input", () => {
        clearTimeout(syncTimer);
        syncTimer = setTimeout(() => syncUrl(input.value.trim()), 400);
      });
    }

    /* 带 ?q= 进来（分享的链接、刷新）就直接出结果 */
    const initialTerm = new URL(window.location.href).searchParams.get("q");
    if (initialTerm) ui.triggerSearch(initialTerm);
  }

  initSearch();
  document.addEventListener("astro:after-swap", () => {
    initialized = false;
    initSearch();
  });
</script>
