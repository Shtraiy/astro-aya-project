# Navidrome 音乐收藏同步（npm run sync:navidrome）
# 复制成 .env 后填写；.env 已在 .gitignore 里，不会入库
NAVIDROME_URL=https://music.example.com
NAVIDROME_USER=readonly-user
NAVIDROME_PASS=your-password

# 可选
# NAVIDROME_LIMIT=500        最多同步多少张专辑
# NAVIDROME_COVER_SIZE=300   封面边长
# NAVIDROME_SKIP_COVERS=1    跳过封面下载，只更新列表

# Bangumi 追番同步（npm run sync:bangumi）
# 只需要用户名（或 UID），公开收藏不需要 token
BANGUMI_USER=your-bangumi-username

# 可选
# BANGUMI_TOKEN=            收藏设为「私密」或要更高频率限制时才需要
# BANGUMI_LIMIT=200          每个分类最多同步多少条
# BANGUMI_SKIP_COVERS=1      跳过封面下载（默认会把封面存到 public/images/bangumi/）
# BANGUMI_PROXY=http://127.0.0.1:7890
#   本地同步才需要：大陆直连 bgm.tv 基本不通（接口和封面图床都会超时）。
#   部署到 Vercel 时不用配 —— 构建机在墙外，直连即可。

# 评论（Waline，可选）
# 留空则文章底部不显示评论区
# PUBLIC_COMMENT_PROVIDER=waline
# PUBLIC_WALINE_SERVER=https://comments.example.com
